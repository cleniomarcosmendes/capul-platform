model SoftwareLicenca {
  id             String         @id @default(uuid())
  modeloLicenca  ModeloLicenca? @map("modelo_licenca")
  quantidade     Int?
  valorTotal     Decimal?       @map("valor_total") @db.Decimal(12, 2)
  valorUnitario  Decimal?       @map("valor_unitario") @db.Decimal(12, 2)
  dataInicio     DateTime?      @map("data_inicio")
  dataVencimento DateTime?      @map("data_vencimento")
  chaveSerial    String?        @map("chave_serial")
  // Chave da NF-e (44 díg.) que originou a licença — vínculo ao módulo Fiscal
  // (rastreabilidade + consulta da NF). NÃO @unique: uma NF pode gerar várias
  // licenças. Opcional. Adicionado 02/06.
  chaveNfe       String?        @map("chave_nfe") @db.Char(44)
  fornecedor     String?
  observacoes    String?
  status         StatusLicenca  @default(ATIVA)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  // Workspace S11 (25/05) — FK opcional p/ FornecedorConfig (cadastro centralizado).
  // Mantém `fornecedor` (string) p/ retrocompat e leitura legado.
  // Mesmo padrão do Contrato (campo texto + FK nullable convivem).
  fornecedorId  String?           @map("fornecedor_id")
  fornecedorRef FornecedorConfig? @relation(fields: [fornecedorId], references: [id])

  softwareId String?   @map("software_id")
  software   Software? @relation(fields: [softwareId], references: [id])

  contratoId String?   @map("contrato_id")
  contrato   Contrato? @relation(fields: [contratoId], references: [id])

  nome          String?
  categoriaId   String?    @map("categoria_id")
  categoria     CategoriaLicenca? @relation(fields: [categoriaId], references: [id])

  // Workspace Multi-Departamento (Onda 1 Sub-fase 1.1 — D8/D31/D32, P2 fechada 22/05)
  // departamentoId = depto que USA a licença (NOT NULL).
  // equipeResponsavelId = equipe T.I. responsável técnica (NULLABLE — preenchido por UX).
  departamentoId      String       @map("departamento_id")
  departamento        Departamento @relation(fields: [departamentoId], references: [id])
  // Workspace Onda 3 S1 (24/05) — depto-lançamento (ver Software).
  departamentoLancamentoId String   @map("departamento_lancamento_id")

  equipeResponsavelId String?      @map("equipe_responsavel_id")
  equipeResponsavel   Equipe?    @relation("EquipeResponsavelLicenca", fields: [equipeResponsavelId], references: [id])

  funcionarios LicencaFuncionario[]

  // 03/06 — toda licença passa a ser ITEM de uma "compra de licença" (cabeçalho
  // NF de compra, ou registro "S/N" = sem nota fiscal). nota_id é NULLABLE nesta
  // fase de transição (o fluxo NF substitui o cadastro antigo na F3). A chave
  // NF-e canônica vive no cabeçalho; o depto de ALOCAÇÃO (departamentoId) é por licença.
  notaId String?        @map("nota_id")
  nota   LicencaCompra? @relation(fields: [notaId], references: [id])

  @@index([dataVencimento])
  @@index([softwareId, status])
  @@index([departamentoId])
  @@index([equipeResponsavelId])
  @@index([fornecedorId])
  @@index([notaId])
  @@map("software_licencas")
  @@schema("gestao_ti")
}

// Cabeçalho da COMPRA DE LICENÇAS (modelo Nota Fiscal — itens = licenças).
// Decisão 03/06: toda licença nasce de um registro destes. numero = "S/N"
// quando registrada SEM nota fiscal (vários registros podem ter "S/N" → sem
// unique em numero). chave_nfe e fornecedor são opcionais (ausentes no S/N).
model LicencaCompra {
  id             String    @id @default(uuid())
  numero         String    @db.VarChar(20)
  semNota        Boolean   @default(false) @map("sem_nota")
  dataLancamento DateTime  @map("data_lancamento")
  dataVencimento DateTime? @map("data_vencimento")
  // Chave NF-e (44 díg.). Ausente quando S/N. Não-unique (S/N repete; e a mesma
  // NF pode, em legado, aparecer em mais de um registro migrado).
  chaveNfe   String?  @map("chave_nfe") @db.Char(44)
  valorTotal Decimal  @default(0) @map("valor_total") @db.Decimal(12, 2)
  observacao String?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  fornecedorId String?           @map("fornecedor_id")
  fornecedor   FornecedorConfig? @relation("LicencaCompraFornecedor", fields: [fornecedorId], references: [id])

  // Criador (nullable: registros migrados do legado não têm autor conhecido).
  criadoPorId String?  @map("criado_por_id")
  criadoPor   Usuario? @relation("LicencaCompraCriadaPor", fields: [criadoPorId], references: [id])

  // Workspace de LANÇAMENTO (oculto na UI) — quem lançou. Auditoria + RBAC.
  departamentoLancamentoId String @map("departamento_lancamento_id")

  itens SoftwareLicenca[]

  @@index([fornecedorId])
  @@index([chaveNfe])
  @@index([dataLancamento])
  @@map("licenca_compras")
  @@schema("gestao_ti")
}

// Vínculo de FUNCIONÁRIO à licença (03/06). Antes era FK para core.usuarios
// (LicencaUsuario); passou a apontar o cadastro de funcionários do Protheus
// por matrícula — cobre quem usa licença mas não tem login no sistema.
// matrícula+nome são resolvidos via INFOCLIENTES (sem senha).
model LicencaFuncionario {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  licencaId String          @map("licenca_id")
  licenca   SoftwareLicenca @relation(fields: [licencaId], references: [id], onDelete: Cascade)

  matricula String  @map("matricula")
  nome      String  @map("nome")

  @@unique([licencaId, matricula])
  @@index([licencaId])
  @@map("licenca_funcionarios")
  @@schema("gestao_ti")
}

// ============================================================
// Contrato e sub-modelos
// ============================================================

model Contrato {
  id                    String          @id @default(uuid())
  numero                Int             @unique @default(autoincrement())
  numeroContrato        String?         @map("numero_contrato")
  titulo                String
  descricao             String?
  status                StatusContrato  @default(ATIVO)
  modalidadeValor       ModalidadeValor @default(FIXO) @map("modalidade_valor")
  fornecedor            String?
  codigoFornecedor      String?         @map("codigo_fornecedor")
  lojaFornecedor        String?         @map("loja_fornecedor")
  codigoProduto         String?         @map("codigo_produto") @db.VarChar(15)
  descricaoProduto      String?         @map("descricao_produto") @db.VarChar(50)

  fornecedorId String?           @map("fornecedor_id")
  fornecedorRef FornecedorConfig? @relation(fields: [fornecedorId], references: [id])

  produtoId String?        @map("produto_id")
  produtoRef ProdutoConfig? @relation(fields: [produtoId], references: [id])
  valorTotal            Decimal         @map("valor_total") @db.Decimal(12, 2)
  valorMensal           Decimal?        @map("valor_mensal") @db.Decimal(12, 2)
  dataInicio            DateTime        @map("data_inicio")
  dataFim               DateTime        @map("data_fim")
  dataAssinatura        DateTime?       @map("data_assinatura")
  dataRenovacao         DateTime?       @map("data_renovacao")
  renovacaoAutomatica   Boolean         @default(false) @map("renovacao_automatica")
  diasAlertaVencimento  Int             @default(30) @map("dias_alerta_vencimento")
  observacoes           String?
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")

  tipoContratoId String?              @map("tipo_contrato_id")
  tipoContrato   TipoContratoConfig?  @relation(fields: [tipoContratoId], references: [id])

  filialId String? @map("filial_id")
  filial   Filial? @relation("ContratoFilial", fields: [filialId], references: [id])

  softwareId String?   @map("software_id")
  software   Software? @relation(fields: [softwareId], references: [id])

  equipeId String?   @map("equipe_id")
  equipe   Equipe? @relation(fields: [equipeId], references: [id])

  contratoOriginalId String?   @map("contrato_original_id")
  contratoOriginal   Contrato? @relation("ContratoRenovacao", fields: [contratoOriginalId], references: [id])
  contratosRenovados Contrato[] @relation("ContratoRenovacao")

  // Workspace Multi-Departamento (Onda 1 Sub-fase 1.1 — D31/D32)
  departamentoId String       @map("departamento_id")
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  // Workspace Onda 3 S1 (24/05) — depto-lançamento (ver Software).
  departamentoLancamentoId String @map("departamento_lancamento_id")

  parcelas                ParcelaContrato[]
  rateioTemplate          RateioTemplate?
  historicos              ContratoHistorico[]
  licencas                SoftwareLicenca[]
  projetos                Projeto[]
  anexos                  AnexoContrato[]
  renovacoesComoAnterior  ContratoRenovacaoReg[] @relation("RenovacaoAnterior")
  renovacoesComoNovo      ContratoRenovacaoReg[] @relation("RenovacaoNovo")

  @@index([status])
  @@index([dataFim])
  @@index([softwareId])
  @@index([departamentoId])
  @@map("contratos")
  @@schema("gestao_ti")
}

model ParcelaContrato {
  id              String        @id @default(uuid())
  numero          Int
  descricao       String?
  valor           Decimal       @db.Decimal(12, 2)
  dataVencimento  DateTime      @map("data_vencimento")
  dataPagamento   DateTime?     @map("data_pagamento")
  status          StatusParcela @default(PENDENTE)
  notaFiscal      String?       @map("nota_fiscal")
  observacoes     String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  contratoId String   @map("contrato_id")
  contrato   Contrato @relation(fields: [contratoId], references: [id])

  rateioItens        ParcelaRateioItem[]
  rateioProjetos     ParcelaRateioProjeto[]

  @@unique([contratoId, numero])
  @@index([dataVencimento])
  @@index([status])
