// MODELOS DO GESTAO_TI — Pendencias de Projeto + Usuarios-Chave
// ============================================================

enum StatusPendencia {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO_VALIDACAO
  CONCLUIDA
  CANCELADA

  @@schema("gestao_ti")
}

enum PrioridadePendencia {
  BAIXA
  MEDIA
  ALTA
  URGENTE

  @@schema("gestao_ti")
}

enum TipoInteracaoPendencia {
  COMENTARIO
  ANEXO
  STATUS_ALTERADO
  RESPONSAVEL_ALTERADO

  @@schema("gestao_ti")
}

model UsuarioChaveProjeto {
  id        String   @id @default(uuid())
  funcao    String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  projetoId String  @map("projeto_id")
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  usuarioId String  @map("usuario_id")
