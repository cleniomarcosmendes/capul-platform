generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["gestao_ti", "core"]
}

// ============================================================
// MODELOS DO CORE — Read-Only neste backend
// Protegido por middleware que bloqueia create/update/delete.
// ============================================================

model Filial {
  id           String  @id
  codigo       String
  nomeFantasia String  @map("nome_fantasia")
  /// CNPJ da filial (existe em core.filiais — exposto aqui para validações
  /// fiscais, ex: vincular chave NF-e em Compras. Read-only.) 14/05/2026.
  cnpj         String?

  chamados        Chamado[]
  ordensServico   OrdemServico[]
  softwareFiliais SoftwareFilial[]
  moduloFiliais   ModuloFilial[]
  paradasAfetadas ParadaFilialAfetada[]
  departamentos   Departamento[]
  ativos          Ativo[]
  contratos       Contrato[]        @relation("ContratoFilial")
  notasFiscais    NotaFiscal[]      @relation("NotaFiscalFilial")

  @@map("filiais")
  @@schema("core")
}

model Usuario {
  id       String  @id
  username String
  nome     String
  email    String?

  // Espelhado de core.usuarios — gestao_ti acessa read-only. Não tem
  // migration neste schema; a coluna é criada pelo Auth Gateway
  // (auth-gateway/prisma/migrations/20260515170000_add_preferencias_usuarios).
  preferencias Json @default("{}") @map("preferencias")

  // S15.6 (27/05) — Espelha core.usuarios.departamento_id (depto principal).
  // Usado por horario.service pra gate STAFF-no-depto-do-alvo. Read-only via
  // middleware (prisma-read-only.middleware.ts). Migration está no Auth Gateway.
  departamentoId String @map("departamento_id")

  membrosEquipe        MembroEquipe[]
  chamadosSolicitados  Chamado[]        @relation("ChamadoSolicitante")
  chamadosTecnico      Chamado[]        @relation("ChamadoTecnico")
  historicosChamado    HistoricoChamado[]
  ordensServicoSolicit OrdemServico[]   @relation("OsSolicitante")
  osTecnicos           OsTecnico[]      @relation("OsTecnicoMembro")
  historicosOs         HistoricoOrdemServico[] @relation("OsHistorico")
  historicosContrato   ContratoHistorico[]
  paradasRegistradas   RegistroParada[]  @relation("ParadaRegistradoPor")
  paradasFinalizadas   RegistroParada[]  @relation("ParadaFinalizadoPor")
  paradasReabertas     RegistroParada[]  @relation("ParadaReabertaPor")
  paradaHistorico      ParadaHistorico[] @relation("HistoricoParadaUsuario")
  projetosResponsavel  Projeto[]          @relation("ProjetoResponsavel")
  membrosProjeto       MembroProjeto[]
  atividadesProjeto    AtividadeProjeto[] @relation("AtividadeProjetoUsuario")
  atividadeResponsavel AtividadeResponsavel[] @relation("AtividadeResponsavelUsuario")
  atividadeHistorico   AtividadeHistorico[] @relation("AtividadeHistoricoUsuario")
  registrosTempo       RegistroTempo[]    @relation("RegistroTempoUsuario")
  riscosResponsavel    RiscoProjeto[]     @relation("RiscoResponsavel")
  anexosProjeto        AnexoProjeto[]     @relation("AnexoProjetoUsuario")
  anexosChamado        AnexoChamado[]     @relation("AnexoChamadoUsuario")
  anexosParada         AnexoParada[]      @relation("AnexoParadaUsuario")
  projetosFavoritos    ProjetoFavorito[]  @relation("ProjetoFavoritoUsuario")
  apontamentosHoras    ApontamentoHoras[] @relation("ApontamentoHorasUsuario")
  ativosResponsavel    Ativo[]            @relation("AtivoResponsavel")
  artigosAutor         ArtigoConhecimento[] @relation("ArtigoAutor")
  notificacoes         Notificacao[]
  chamadoColaboracoes  ChamadoColaborador[]    @relation("ChamadoColaborador")
  chamadoCopias               ChamadoCopia[]   @relation("ChamadoCopiaUsuario")
  chamadosCopiaAdicionadosPor ChamadoCopia[]   @relation("ChamadoCopiaAdicionadoPor")
  paradaColaboracoes   ParadaColaborador[]     @relation("ParadaColaborador")
  registrosTempoChm    RegistroTempoChamado[]  @relation("RegistroTempoChamado")
  comentariosTarefa    ComentarioTarefa[]      @relation("ComentarioTarefaUsuario")
  usuarioChaveProjetos   UsuarioChaveProjeto[]   @relation("UsuarioChaveProjeto")
  chamadosExternosRegistrados ChamadoExternoMensal[] @relation("ChamadoExternoRegistradoPor")
  pendenciasResponsavel  PendenciaProjeto[]      @relation("PendenciaResponsavel")
  pendenciasCriador      PendenciaProjeto[]      @relation("PendenciaCriador")
  interacoesPendencia    InteracaoPendencia[]    @relation("InteracaoPendenciaUsuario")
  anexosPendencia        AnexoPendencia[]        @relation("AnexoPendenciaUsuario")
  anexosConhecimento     AnexoConhecimento[]     @relation("AnexoConhecimentoUsuario")
  horarioTrabalho        HorarioTrabalho?        @relation("HorarioTrabalho")
  notasFiscaisCriadas    NotaFiscal[]            @relation("NotaFiscalCriadaPor")
  licencaCompras         LicencaCompra[]         @relation("LicencaCompraCriadaPor")
  anexosNotaFiscal       AnexoNotaFiscal[]       @relation("AnexoNFUsuario")
  alteracoesChaveNF      NotaFiscalChaveHistorico[] @relation("NFChaveAlteradoPor")

  @@map("usuarios")
  @@schema("core")
}

model CentroCusto {
  id     String @id
  codigo String
  nome   String

  rateioTemplateItens RateioTemplateItem[]
  parcelaRateioItens  ParcelaRateioItem[]
  notaFiscalItens     NotaFiscalItem[]

  @@map("centros_custo")
  @@schema("core")
}

model TipoDepartamento {
  id   String @id
  nome String
  ordem Int   @default(0)

  departamentos Departamento[]

  @@map("tipos_departamento")
  @@schema("core")
}

model Departamento {
  id   String @id
  nome String

  filialId           String           @map("filial_id")
  filial             Filial           @relation(fields: [filialId], references: [id])
  tipoDepartamentoId String           @map("tipo_departamento_id")
  tipoDepartamento   TipoDepartamento @relation(fields: [tipoDepartamentoId], references: [id])

  // Reversas pré-existentes
  ativos          Ativo[]
  chamados        Chamado[]

  // Workspace Multi-Departamento (Onda 1 Sub-fase 1.1 — D31/D32)
  // 9 reversas novas para as entidades operacionais multi-depto.
  equipes          Equipe[]
  projetos         Projeto[]
  ordensServico    OrdemServico[]
  contratos        Contrato[]
  notasFiscais     NotaFiscal[]
  softwares        Software[]
  softwareLicencas SoftwareLicenca[]
  registrosParada  RegistroParada[]
  motivosParada    MotivoParada[]

  // Workspace Onda 2 C2.7 refino — chamados externos por depto-dono
  chamadosExternosMensal ChamadoExternoMensal[]

  @@map("departamentos")
  @@schema("core")
}

// ============================================================
// MODELOS DO GESTAO_TI — Fase 1
// ============================================================

enum StatusGeral {
  ATIVO
  INATIVO

  @@schema("gestao_ti")
}

model Equipe {
  id                   String      @id @default(uuid())
  nome                 String      @unique
  sigla                String      @unique
  descricao            String?
  cor                  String?     @default("#3B82F6")
  icone                String?     @default("users")
  // Visibilidade na ABERTURA de chamado (unifica/substitui aceita_chamado_externo).
  // privada=true => só staff (ADMIN/GESTOR/SUPORTE) do PRÓPRIO departamento pode
  // abrir chamado direto pra equipe; usuário final/chave/terceirizado e staff de
  // outros deptos não a veem. Transferência permanece global (inalterada).
  privada              Boolean     @default(false)
  // Visibilidade na LISTAGEM de chamado (independe de `privada`).
  // restritaVisibilidade=true => chamados desta equipe só são VISÍVEIS aos
  // membros ativos dela; nem o staff do depto (não-membro) vê na listagem.
  // Solicitante/técnico/colaborador do chamado e ADMIN seguem vendo (carve-out
  // aplicado SÓ na cláusula de visibilidade por departamento).
  restritaVisibilidade Boolean     @default(false) @map("restrita_visibilidade")
  // SAC (Fase 1) — equipe-CATÁLOGO de apoiadores: seus membros são os elegíveis
  // a serem puxados "em cópia" num SAC. NÃO é fila: equipe apoioSac NUNCA pode
  // ser equipeAtual de um chamado (guard "roster não roteável") — por isso ser
  // membro dela não dá visibilidade de fila (a cláusula equipeAtualId nunca casa).
  apoioSac             Boolean     @default(false) @map("apoio_sac")
  // SAC — equipe de ATENDIMENTO ao SAC (recebe os chamados de SAC). Distinta da
  // apoioSac (roster). É o que define "chamado é SAC" (por EQUIPE, não por depto):
  // um workspace pode ter equipe de SAC E equipe de chamado normal.
  atendeSac            Boolean     @default(false) @map("atende_sac")
  emailEquipe          String?     @map("email_equipe")
  ordem                Int         @default(0)
  status               StatusGeral @default(ATIVO)
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  // Workspace Multi-Departamento (Onda 1 Sub-fase 1.1 — D31/D32)
  // Equipe pertence a um departamento (depto dono). GESTOR só vê equipes do dele.
  departamentoId String       @map("departamento_id")
  departamento   Departamento @relation(fields: [departamentoId], references: [id])

  membros              MembroEquipe[]
  chamados             Chamado[]
  catalogoServicos     CatalogoServico[]
  slaDefinicoes        SlaDefinicao[]
  historicosOrigem     HistoricoChamado[] @relation("HistoricoEquipeOrigem")
  historicosDestino    HistoricoChamado[] @relation("HistoricoEquipeDestino")
  softwaresResponsavel Software[]
  licencasResponsavel  SoftwareLicenca[] @relation("EquipeResponsavelLicenca")
  artigos              ArtigoConhecimento[]
  contratos            Contrato[]
  notasFiscais         NotaFiscal[]

  @@index([departamentoId])
  @@map("equipes_ti")
  @@schema("gestao_ti")
}

model MembroEquipe {
  id                  String      @id @default(uuid())
  isLider             Boolean     @default(false) @map("is_lider")
  podeGerirContratos  Boolean     @default(false) @map("pode_gerir_contratos")
  podeGerirCompras    Boolean     @default(false) @map("pode_gerir_compras")
  status              StatusGeral @default(ATIVO)
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  usuarioId String   @map("usuario_id")
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])
  equipeId  String   @map("equipe_id")
  equipe    Equipe @relation(fields: [equipeId], references: [id])

  @@unique([usuarioId, equipeId])
  @@map("membros_equipe")
  @@schema("gestao_ti")
}

// ============================================================
// MODELOS DO GESTAO_TI — Fase 2 (Suporte)
// ============================================================

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  CRITICA

  @@schema("gestao_ti")
}

/// SAC (Fase 1) — canal por onde o atendimento ao cliente entrou. Usado só nos
/// chamados do workspace SAC; nullable (chamados internos não preenchem).
enum CanalOrigemSac {
  BALCAO
  TELEFONE
  EMAIL
  OUTRO

  @@schema("gestao_ti")
}

// SAC Fase 3 (e-mail de ENTRADA) — config OPERACIONAL do poller IMAP. Singleton
// (sempre id=1). A CONEXÃO IMAP (host/porta/usuário/senha/TLS) vem do AMBIENTE
// (vars SAC_IMAP_*, espelhando SMTP_*) — segredo NÃO fica no banco. Aqui só o
// estado/toggles que o admin gerencia pela tela + a observabilidade (último
// status). Pra não ser black-box.
model SacEmailConfig {
  id                  Int       @id @default(1)
  // Liga/desliga o consumo automático (poller agendado — efetivo só na 3d).
  enabled             Boolean   @default(false)
  // Freio de mão: pausa o ciclo sem perder a config.
  pauseSync           Boolean   @default(false) @map("pause_sync")
  // Pasta IMAP a varrer e frequência do poll.
  mailboxFolder       String    @default("INBOX") @map("mailbox_folder")
  pollIntervalMinutes Int       @default(5) @map("poll_interval_minutes")
  // Observabilidade (preenchidos pelo serviço): último ciclo + erro + total.
  lastPollAt          DateTime? @map("last_poll_at")
  lastStatus          String?   @map("last_status")
  lastError           String?   @map("last_error")
  processadosTotal    Int       @default(0) @map("processados_total")
  // Auditoria da edição da config.
  updatedAt           DateTime  @updatedAt @map("updated_at")
  updatedBy           String?   @map("updated_by")

  @@map("sac_email_config")
  @@schema("gestao_ti")
}

// SAC Fase 3 (3b) — classificação de cada e-mail buscado. Dedupe por messageId
// (sintético quando o e-mail não traz Message-ID). Na 3b só CLASSIFICA e LOGA;
// a criação do histórico no chamado (MATCHED) é a 3c.
enum ResultadoIngestaoSac {
  MATCHED       // [SAC-n] casou com um chamado existente
  UNMATCHED     // sem [SAC-n] ou número inexistente → triagem
  SKIPPED_AUTO  // auto-resposta/bounce (anti-loop)
  SKIPPED_OWN   // veio do nosso próprio remetente (SMTP_FROM)
  DUPLICATE     // messageId já processado
  ERROR         // falha ao processar a mensagem

  @@schema("gestao_ti")
}

model SacEmailIngestao {
  id           String               @id @default(uuid())
  // Chave de dedupe (Message-ID; sintético se ausente).
  messageId    String               @unique @map("message_id")
  fromAddr     String?              @map("from_addr")
  subject      String?
  sacNumero    Int?                 @map("sac_numero")
  chamadoId    String?              @map("chamado_id")
  resultado    ResultadoIngestaoSac
  motivo       String?
  recebidoEm   DateTime?            @map("recebido_em")
  processadoEm DateTime             @default(now()) @map("processado_em")

  @@index([processadoEm])
  @@map("sac_email_ingestao")
  @@schema("gestao_ti")
}

enum StatusChamado {
  ABERTO
  EM_ATENDIMENTO
  PENDENTE
  /// Chamado em atendimento mas técnico solicitou informação ao solicitante
  /// — fica parado até o solicitante responder (auto-volta para EM_ATENDIMENTO).
  /// Adicionado em 29/04/2026 para reduzir ambiguidade do PENDENTE genérico.
  PENDENTE_USUARIO
  RESOLVIDO
  FECHADO
  CANCELADO
  REABERTO
  /// Chamado agrupado em outro (chamado-pai). Tratado como "fora da fila"
  /// — SLA pausado, nao aparece em listagens padrao. Resposta acontece no
  /// pai e propaga via historico. Decidido em 13/05/2026.
  AGRUPADO

  @@schema("gestao_ti")
}

enum Visibilidade {
  PUBLICO
  PRIVADO

  @@schema("gestao_ti")
}

enum TipoHistorico {
  ABERTURA
  ASSUMIDO
  TRANSFERENCIA_EQUIPE
  TRANSFERENCIA_TECNICO
  COMENTARIO
  /// Técnico solicitou informações ao solicitante. Status muda para
  /// PENDENTE_USUARIO. Adicionado em 29/04/2026.
  SOLICITACAO_INFO
  /// Solicitante respondeu chamado em PENDENTE_USUARIO. Auto-volta para
  /// EM_ATENDIMENTO. Adicionado em 29/04/2026.
  RETOMADA_USUARIO
  RESOLVIDO
  FECHADO
  REABERTO
  CANCELADO
  AVALIADO
  /// Chamado foi agrupado em outro (virou filho). Decidido em 13/05/2026.
  AGRUPADO_EM
  /// Chamado foi desagrupado (voltou ao status anterior).
  DESAGRUPADO
  /// Resposta no agrupador propagada para os filhos. Registrada em cada filho
  /// com referencia ao agrupador.
  RESPONDIDO_EM_GRUPO
  /// Cascata de resolucao/fechamento do agrupador para os filhos.
  RESOLVIDO_EM_GRUPO
  FECHADO_EM_GRUPO

  @@schema("gestao_ti")
}

enum StatusOS {
  ABERTA
  EM_EXECUCAO
  CONCLUIDA
  CANCELADA

  @@schema("gestao_ti")
}

model CatalogoServico {
  id               String      @id @default(uuid())
  nome             String
  descricao        String?
  prioridadePadrao Prioridade  @default(MEDIA) @map("prioridade_padrao")
  slaPadraoHoras   Int?        @map("sla_padrao_horas")
  ordem            Int         @default(0)
  status           StatusGeral @default(ATIVO)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  equipeId String   @map("equipe_id")
  equipe   Equipe @relation(fields: [equipeId], references: [id])

  chamados Chamado[]

  @@unique([equipeId, nome])
  @@map("catalogo_servicos")
  @@schema("gestao_ti")
}

model SlaDefinicao {
  id             String      @id @default(uuid())
  nome           String
  prioridade     Prioridade
  horasResposta  Int         @map("horas_resposta")
  horasResolucao Int         @map("horas_resolucao")
  status         StatusGeral @default(ATIVO)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  equipeId String   @map("equipe_id")
  equipe   Equipe @relation(fields: [equipeId], references: [id])

  chamados Chamado[]

  @@unique([equipeId, prioridade])
  @@map("sla_definicoes")
  @@schema("gestao_ti")
}

model Chamado {
  id                 String        @id @default(uuid())
  numero             Int           @unique @default(autoincrement())
  titulo             String
  descricao          String
  visibilidade       Visibilidade  @default(PUBLICO)
  prioridade         Prioridade    @default(MEDIA)
  status             StatusChamado @default(ABERTO)
  softwareNome       String?       @map("software_nome")
  moduloNome         String?       @map("modulo_nome")
  dataLimiteSla      DateTime?     @map("data_limite_sla")
  dataResolucao      DateTime?     @map("data_resolucao")
  dataFechamento     DateTime?     @map("data_fechamento")
  notaSatisfacao     Int?          @map("nota_satisfacao")
  comentarioSatisfacao String?     @map("comentario_satisfacao")
  ipMaquina            String?       @map("ip_maquina")
  matriculaColaborador String?       @map("matricula_colaborador")
  nomeColaborador      String?       @map("nome_colaborador")
  // SAC — dados do CLIENTE externo (o colaborador registra em nome dele; o
  // cliente não é usuário do sistema). Nullable: só preenchidos nos chamados SAC.
  // `clienteEmail` habilita o e-mail de saída (Fase 2); telefone é contato à parte.
  clienteNome          String?         @map("cliente_nome")
  clienteEmail         String?         @map("cliente_email")
  clienteTelefone      String?         @map("cliente_telefone")
  canalOrigem          CanalOrigemSac? @map("canal_origem")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  solicitanteId String  @map("solicitante_id")
  solicitante   Usuario @relation("ChamadoSolicitante", fields: [solicitanteId], references: [id])

  tecnicoId String?  @map("tecnico_id")
  tecnico   Usuario? @relation("ChamadoTecnico", fields: [tecnicoId], references: [id])

  equipeAtualId String   @map("equipe_atual_id")
  equipeAtual   Equipe @relation(fields: [equipeAtualId], references: [id])

  filialId String @map("filial_id")
  filial   Filial @relation(fields: [filialId], references: [id])

  catalogoServicoId String?          @map("catalogo_servico_id")
  catalogoServico   CatalogoServico? @relation(fields: [catalogoServicoId], references: [id])

  slaDefinicaoId String?       @map("sla_definicao_id")
  slaDefinicao   SlaDefinicao? @relation(fields: [slaDefinicaoId], references: [id])

  softwareId       String?         @map("software_id")
  software         Software?       @relation(fields: [softwareId], references: [id])

  softwareModuloId String?          @map("software_modulo_id")
  softwareModulo   SoftwareModulo?  @relation(fields: [softwareModuloId], references: [id])

  projetoId String?  @map("projeto_id")
  projeto   Projeto? @relation(fields: [projetoId], references: [id])

  ativoId String? @map("ativo_id")
  ativo   Ativo?  @relation(fields: [ativoId], references: [id])

  // Workspace Multi-Departamento C2.7 (24/05) — depto-dono do chamado
  // derivado da equipe que ATENDE (`equipeAtual.departamentoId`).
  // Tornado NOT NULL em 24/05 após auditoria confirmar 0 órfãos.
  departamentoId String       @map("departamento_id")
  departamento   Departamento @relation(fields: [departamentoId], references: [id])

  /// Agrupamento de chamados (decidido em 13/05/2026): quando varios usuarios
  /// abrem chamados com o mesmo problema, TI agrupa todos em um chamado-pai.
  /// Filhos ficam em status AGRUPADO (SLA pausado, fora dos filtros padroes).
  /// Resposta no pai propaga para os filhos via historico/notificacao.
  /// Closure do pai cascateia para os filhos.
  chamadoAgrupadorId       String?   @map("chamado_agrupador_id")
  chamadoAgrupador         Chamado?  @relation("ChamadoAgrupamento", fields: [chamadoAgrupadorId], references: [id])
  chamadosAgrupados        Chamado[] @relation("ChamadoAgrupamento")

  /// Status original antes de ser agrupado — usado para restaurar ao desagrupar.
  /// Tipo String (nao StatusChamado) pra evitar Prisma forcar enum em update parcial.
  statusAnteriorAgrupamento String?  @map("status_anterior_agrupamento")

  /// Timestamp do agrupamento — usado para somar tempo pausado a dataLimiteSla
  /// na hora de desagrupar.
  slaPausadoEm             DateTime? @map("sla_pausado_em")

  historicos      HistoricoChamado[]
  osChamados      OsChamado[]
  paradas         ParadaChamado[]
  anexos          AnexoChamado[]
  colaboradores   ChamadoColaborador[]
  copias          ChamadoCopia[]
  registrosTempo  RegistroTempoChamado[]

  @@index([status])
  @@index([equipeAtualId, status])
  @@index([solicitanteId])
  @@index([tecnicoId])
  @@index([chamadoAgrupadorId])
  @@map("chamados")
  @@schema("gestao_ti")
}

model HistoricoChamado {
  id        String        @id @default(uuid())
  tipo      TipoHistorico
  descricao String?
  publico   Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at")

  chamadoId String  @map("chamado_id")
  chamado   Chamado @relation(fields: [chamadoId], references: [id])

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  equipeOrigemId  String?   @map("equipe_origem_id")
  equipeOrigem    Equipe? @relation("HistoricoEquipeOrigem", fields: [equipeOrigemId], references: [id])

  equipeDestinoId String?   @map("equipe_destino_id")
  equipeDestino   Equipe? @relation("HistoricoEquipeDestino", fields: [equipeDestinoId], references: [id])

  @@index([chamadoId])
  @@map("historicos_chamado")
  @@schema("gestao_ti")
}

model AnexoChamado {
  id            String   @id @default(uuid())
  nomeOriginal  String   @map("nome_original")
