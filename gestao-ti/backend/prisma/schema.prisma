  interacoes InteracaoPendencia[]
  anexos     AnexoPendencia[]
  atividades AtividadeProjeto[]

  @@index([projetoId, status])
  @@index([responsavelId])
  @@map("pendencias_projeto")
  @@schema("gestao_ti")
}

model InteracaoPendencia {
  id        String                  @id @default(uuid())
  tipo      TipoInteracaoPendencia
  descricao String?
  publica   Boolean                 @default(true)
  // Flag marcada quando o anexo originalmente vinculado a esta interação é
  // excluído da sidebar — preserva o "rastro" pra UI mostrar chip "anexo
  // removido" (paridade com chamado, 14/05/2026).
  anexoRemovido Boolean             @default(false) @map("anexo_removido")
  createdAt DateTime                @default(now()) @map("created_at")

  pendenciaId String            @map("pendencia_id")
  pendencia   PendenciaProjeto  @relation(fields: [pendenciaId], references: [id], onDelete: Cascade)

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation("InteracaoPendenciaUsuario", fields: [usuarioId], references: [id])

  // Many-to-one (14/05/2026 — incidente Marco Antonio): 1 interacao pode ter
  // N anexos. Antes era 1:1 (campo `anexo` singular) — virou array.
  anexos AnexoPendencia[]

  @@index([pendenciaId])
  @@map("interacoes_pendencia")
  @@schema("gestao_ti")
}

model AnexoPendencia {
  id           String   @id @default(uuid())
  nomeOriginal String   @map("nome_original")
  nomeArquivo  String   @map("nome_arquivo")
  mimeType     String   @map("mime_type")
  tamanho      Int
  createdAt    DateTime @default(now()) @map("created_at")

  pendenciaId String           @map("pendencia_id")
  pendencia   PendenciaProjeto @relation(fields: [pendenciaId], references: [id], onDelete: Cascade)

  interacaoId String?             @map("interacao_id")
  interacao   InteracaoPendencia? @relation(fields: [interacaoId], references: [id])

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation("AnexoPendenciaUsuario", fields: [usuarioId], references: [id])

  @@index([pendenciaId])
  @@map("anexos_pendencia")
  @@schema("gestao_ti")
}


model HorarioTrabalho {
  id                   String   @id @default(uuid())
  horaInicioExpediente String   @default("08:00") @map("hora_inicio_expediente")
  horaFimExpediente    String   @default("17:00") @map("hora_fim_expediente")
  horaInicioAlmoco     String   @default("12:00") @map("hora_inicio_almoco")
  horaFimAlmoco        String   @default("13:00") @map("hora_fim_almoco")
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  usuarioId String?  @unique @map("usuario_id")
  usuario   Usuario? @relation("HorarioTrabalho", fields: [usuarioId], references: [id])

  @@map("horarios_trabalho")
  @@schema("gestao_ti")
}

// ── Fase 7: Compras de TI — Notas Fiscais ──

enum StatusNotaFiscal {
  REGISTRADA
  CONFERIDA
  CANCELADA

  @@schema("gestao_ti")
}

model NotaFiscal {
  id           String            @id @default(uuid())
  numero       String            @db.VarChar(20)
  dataLancamento  DateTime          @map("data_lancamento")
  dataVencimento  DateTime?         @map("data_vencimento")
  status       StatusNotaFiscal  @default(REGISTRADA)
  observacao   String?
  valorTotal   Decimal           @default(0) @map("valor_total") @db.Decimal(12, 2)
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  /// Chave da NF-e (44 dígitos). Quando informada, vincula esta NF Compras ao
  /// XML armazenado no módulo Fiscal (SZR/SZQ + cache fiscal.documento_consulta).
  /// Opcional — fornecedores não-NF-e ou retroativos seguem sem chave.
  /// Edição bloqueada quando status >= CONFERIDA; em REGISTRADA exige motivo
  /// e gera audit em NotaFiscalChaveHistorico. Adicionado 14/05/2026.
  chaveNfe   String? @unique @map("chave_nfe") @db.Char(44)

  fornecedorId String          @map("fornecedor_id")
  fornecedor   FornecedorConfig @relation(fields: [fornecedorId], references: [id])

  filialId String @map("filial_id")
  filial   Filial @relation("NotaFiscalFilial", fields: [filialId], references: [id])

  criadoPorId String  @map("criado_por_id")
  criadoPor   Usuario @relation("NotaFiscalCriadaPor", fields: [criadoPorId], references: [id])

  equipeId String?   @map("equipe_id")
  equipe   Equipe? @relation(fields: [equipeId], references: [id])

  // Workspace Multi-Departamento (Onda 1 Sub-fase 1.1 — D31/D32/D38)
  // filialId continua NOT NULL (D38/Q2 — Workspace NÃO é escrituração fiscal;
  // filial é vestigial mas DB preserva integridade). RBAC usa departamentoId.
  departamentoId String       @map("departamento_id")
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  // Workspace Onda 3 S1 (24/05) — depto-lançamento (ver Software).
  departamentoLancamentoId String @map("departamento_lancamento_id")

  itens          NotaFiscalItem[]
  anexos         AnexoNotaFiscal[]
  chaveHistorico NotaFiscalChaveHistorico[]

  @@unique([numero, fornecedorId])
  @@index([fornecedorId])
  @@index([filialId])
  @@index([equipeId])
  @@index([dataLancamento])
  @@index([departamentoId])
  @@map("notas_fiscais")
  @@schema("gestao_ti")
}

/// Audit log de alterações da chave NF-e em NotaFiscal (Compras TI). Cada
/// linha = uma troca (vínculo inicial registra chaveAnterior=null). Permite
/// rastrear quem trocou, quando e por quê (motivo obrigatório se chave
/// preexistente). Adicionado 14/05/2026.
model NotaFiscalChaveHistorico {
  id              String   @id @default(uuid())
  chaveAnterior   String?  @map("chave_anterior") @db.Char(44)
  chaveNova       String?  @map("chave_nova") @db.Char(44)
  motivo          String?
  alteradoEm      DateTime @default(now()) @map("alterado_em")

  notaFiscalId String     @map("nota_fiscal_id")
  notaFiscal   NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)

  alteradoPorId String  @map("alterado_por_id")
  alteradoPor   Usuario @relation("NFChaveAlteradoPor", fields: [alteradoPorId], references: [id])

  @@index([notaFiscalId])
  @@index([alteradoPorId])
  @@map("nota_fiscal_chave_historico")
  @@schema("gestao_ti")
}

model AnexoNotaFiscal {
  id           String   @id @default(uuid())
  nomeOriginal String   @map("nome_original")
  nomeArquivo  String   @map("nome_arquivo")
  mimeType     String   @map("mime_type")
  tamanho      Int
  createdAt    DateTime @default(now()) @map("created_at")

  notaFiscalId String     @map("nota_fiscal_id")
  notaFiscal   NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation("AnexoNFUsuario", fields: [usuarioId], references: [id])

  @@index([notaFiscalId])
  @@map("anexos_nota_fiscal")
  @@schema("gestao_ti")
}

model NotaFiscalItem {
  id            String  @id @default(uuid())
  quantidade    Int
  valorUnitario Decimal @map("valor_unitario") @db.Decimal(12, 2)
  valorTotal    Decimal @map("valor_total") @db.Decimal(12, 2)
  observacao    String?

  notaFiscalId String     @map("nota_fiscal_id")
  notaFiscal   NotaFiscal @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)

  produtoId String        @map("produto_id")
  produto   ProdutoConfig @relation(fields: [produtoId], references: [id])

  centroCustoId String      @map("centro_custo_id")
  centroCusto   CentroCusto @relation(fields: [centroCustoId], references: [id])

  projetoId String?  @map("projeto_id")
  projeto   Projeto? @relation(fields: [projetoId], references: [id])

  @@index([notaFiscalId])
  @@index([produtoId])
  @@index([projetoId])
  @@index([centroCustoId])
  @@map("nota_fiscal_itens")
  @@schema("gestao_ti")
}

/// Cache de respostas para idempotência em endpoints de criação.
/// Auditoria 10/05/2026 #M3 — defesa em profundidade contra duplicação por
/// retry de cliente após timeout/network glitch.
///
/// Uso: cliente envia header `Idempotency-Key: <uuid>`. Backend faz lookup
/// por (usuario_id, key); se cached e não expirou, retorna resposta cacheada.
/// Senão, executa request normal e cacheia a resposta com TTL 24h.
///
/// Cleanup: cron @daily apaga registros com expires_at < now().
model IdempotencyKey {
  id             String   @id @default(uuid())
  /// Chave gerada pelo cliente (UUID/ULID/qualquer string única do request)
  key            String   @db.VarChar(128)
  /// userId do JWT (isola entre usuários)
  usuarioId      String   @map("usuario_id")
  /// Method + path para detectar mau uso (cliente enviando mesma key em endpoints diferentes)
  method         String   @db.VarChar(10)
  path           String   @db.VarChar(255)
  /// Response cacheada
  responseStatus Int      @map("response_status")
  responseBody   Json?    @map("response_body")
  createdAt      DateTime @default(now()) @map("created_at")
  expiresAt      DateTime @map("expires_at")

  @@unique([usuarioId, key], name: "idempotency_user_key")
  @@index([expiresAt]) // pra cleanup eficiente
  @@map("idempotency_keys")
  @@schema("gestao_ti")
}
