// ============================================================
// MODELOS DO GESTAO_TI — Chamados externos (KPI manual)
// ============================================================

/// Registro mensal de chamados que a CAPUL abriu junto a fornecedores
/// externos (TOTVS, ZANTHUS, LINIX, etc.). Alimenta o KPI no Dashboard
/// de Indicadores Estrategicos. Lancamento manual pelo time T.I.
/// (ADMIN/GESTOR_TI). Decidido em 13/05/2026.
model ChamadoExternoMensal {
  id              String   @id @default(uuid())
  mes             Int      // 1-12
  ano             Int
  qtdChamados     Int      @map("qtd_chamados")
  observacoes     String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  softwareId String   @map("software_id")
  software   Software @relation(fields: [softwareId], references: [id])

  registradoPorId String?  @map("registrado_por_id")
  registradoPor   Usuario? @relation("ChamadoExternoRegistradoPor", fields: [registradoPorId], references: [id])

  // Workspace Multi-Departamento (Onda 2 C2.7 refino 23/05) — depto-dono.
  // Cada workspace pode lançar seus próprios chamados externos (Fiscal
  // pode lançar Totvs, Controladoria também, separadamente). Opcional
  // pra retrocompat com registros pré-migration (todos migrados pra T.I.).
  departamentoId String?       @map("departamento_id")
  departamento   Departamento? @relation(fields: [departamentoId], references: [id])

  @@unique([mes, ano, softwareId, departamentoId])
  @@index([ano, mes])
  @@index([softwareId])
  @@index([departamentoId])
  @@map("chamados_externos_mensal")
  @@schema("gestao_ti")
}

