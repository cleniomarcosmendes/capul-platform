  historico      AtividadeHistorico[]

  @@index([projetoId, dataAtividade])
  @@index([pendenciaId])
  @@map("atividades_projeto")
  @@schema("gestao_ti")
}

// Timeline imutável de eventos da tarefa (criada, status, cronômetro, nota...).
// Mesmo padrão de ParadaHistorico — append-only, nome do autor resolvido na leitura.
model AtividadeHistorico {
  id          String              @id @default(uuid())
  atividadeId String              @map("atividade_id")
  atividade   AtividadeProjeto    @relation(fields: [atividadeId], references: [id], onDelete: Cascade)
  tipo        TipoEventoAtividade
  descricao   String?
  usuarioId   String?             @map("usuario_id")
  usuario     Usuario?            @relation("AtividadeHistoricoUsuario", fields: [usuarioId], references: [id])
  metadata    Json?
  createdAt   DateTime            @default(now()) @map("created_at")

  @@index([atividadeId, createdAt])
  @@map("atividade_historico")
  @@schema("gestao_ti")
}

enum TipoEventoAtividade {
  CRIADA
  STATUS_ALTERADO
  TITULO_ALTERADO
  RESPONSAVEL_ALTERADO
  FASE_ALTERADA
  TEMPO_INICIADO
  TEMPO_ENCERRADO
  COMENTARIO_ADICIONADO

