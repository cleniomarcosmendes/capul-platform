model ContratoHistorico {
  id        String                @id @default(uuid())
  tipo      TipoHistoricoContrato
  descricao String?
  dadosJson String?               @map("dados_json")
  createdAt DateTime              @default(now()) @map("created_at")

  contratoId String   @map("contrato_id")
  contrato   Contrato @relation(fields: [contratoId], references: [id])

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@index([contratoId])
  @@map("contrato_historicos")
  @@schema("gestao_ti")
}

// ── Fase 4: Sustentacao ERP — Models ──

model MotivoParada {
  id        String   @id @default(uuid())
  nome      String
  descricao String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Workspace Multi-Departamento (Onda 1 Sub-fase 1.1 — D31/D32)
  departamentoId String       @map("departamento_id")
  departamento   Departamento @relation(fields: [departamentoId], references: [id])

  paradas RegistroParada[]

  @@index([departamentoId])
  @@map("motivos_parada")
  @@schema("gestao_ti")
}

model RegistroParada {
  id             String        @id @default(uuid())
  titulo         String
  descricao      String?
  tipo           TipoParada
  impacto        ImpactoParada
  status         StatusParada  @default(EM_ANDAMENTO)
  inicio         DateTime
  fim            DateTime?
  duracaoMinutos Int?          @map("duracao_minutos")
  observacoes    String?
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  motivoParadaId   String?         @map("motivo_parada_id")
  motivoParada     MotivoParada?   @relation(fields: [motivoParadaId], references: [id])

  softwareId       String          @map("software_id")
  software         Software        @relation(fields: [softwareId], references: [id])

  softwareModuloId String?         @map("software_modulo_id")
  softwareModulo   SoftwareModulo? @relation(fields: [softwareModuloId], references: [id])

  registradoPorId String  @map("registrado_por_id")
  registradoPor   Usuario @relation("ParadaRegistradoPor", fields: [registradoPorId], references: [id])

  finalizadoPorId String?  @map("finalizado_por_id")
  finalizadoPor   Usuario? @relation("ParadaFinalizadoPor", fields: [finalizadoPorId], references: [id])

  /// Quando esta parada FOI reaberta (último reabrir). Se setado, indica que
  /// a parada está em estado "EM_ANDAMENTO pós-reabertura" — finalizar exige
  /// observações com mínimo 10 chars (rastreabilidade do que mudou).
  /// Após nova finalização, é zerado.
  reabertaEm      DateTime? @map("reaberta_em")
  reabertaPorId   String?   @map("reaberta_por_id")
  reabertaPor     Usuario?  @relation("ParadaReabertaPor", fields: [reabertaPorId], references: [id])

  // Workspace Multi-Departamento (Onda 1 Sub-fase 1.1 — D31/D32)
  departamentoId String       @map("departamento_id")
  departamento   Departamento @relation(fields: [departamentoId], references: [id])
  // Workspace Onda 3 S1 (24/05) — depto-lançamento (ver Software).
  departamentoLancamentoId String @map("departamento_lancamento_id")

  filiaisAfetadas ParadaFilialAfetada[]
  chamados        ParadaChamado[]
  colaboradores   ParadaColaborador[]
  anexos          AnexoParada[]
  historico       ParadaHistorico[]

  @@index([softwareId, status])
  @@index([status])
  @@index([inicio])
  @@index([departamentoId])
  @@map("registros_parada")
  @@schema("gestao_ti")
}

/// Timeline imutável de eventos da parada. Cada transição de estado
/// (REGISTRADA, REABERTA, FINALIZADA, CANCELADA) cria uma entrada com
/// observações livres + metadata (JSON com dados extras tipo `fim`,
/// `duracaoMinutos`). Auditoria completa: o campo `observacoes` da
/// parada continua sendo snapshot da última observação, mas o
/// histórico cresce indefinidamente.
model ParadaHistorico {
  id          String           @id @default(uuid())
  paradaId    String           @map("parada_id")
  parada      RegistroParada   @relation(fields: [paradaId], references: [id], onDelete: Cascade)
  tipoEvento  TipoEventoParada @map("tipo_evento")
  usuarioId   String?          @map("usuario_id")
  usuario     Usuario?         @relation("HistoricoParadaUsuario", fields: [usuarioId], references: [id])
  observacoes String?
  metadata    Json?
  createdAt   DateTime         @default(now()) @map("created_at")

  @@index([paradaId, createdAt])
  @@map("parada_historico")
  @@schema("gestao_ti")
}

model ParadaFilialAfetada {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  paradaId String         @map("parada_id")
  parada   RegistroParada @relation(fields: [paradaId], references: [id], onDelete: Cascade)

  filialId String @map("filial_id")
  filial   Filial @relation(fields: [filialId], references: [id])

  @@unique([paradaId, filialId])
  @@map("parada_filiais_afetadas")
  @@schema("gestao_ti")
}

model ParadaChamado {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  paradaId String         @map("parada_id")
  parada   RegistroParada @relation(fields: [paradaId], references: [id], onDelete: Cascade)

  chamadoId String  @map("chamado_id")
  chamado   Chamado @relation(fields: [chamadoId], references: [id])

  @@unique([paradaId, chamadoId])
  @@map("parada_chamados")
  @@schema("gestao_ti")
}

model ParadaColaborador {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  paradaId String          @map("parada_id")
  parada   RegistroParada  @relation(fields: [paradaId], references: [id], onDelete: Cascade)

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation("ParadaColaborador", fields: [usuarioId], references: [id])

  @@unique([paradaId, usuarioId])
  @@map("parada_colaboradores")
  @@schema("gestao_ti")
}

// ── Fase 5: Projetos de TI — Models ──

model Projeto {
  id              String        @id @default(uuid())
  numero          Int           @unique @default(autoincrement())
  nome            String
  descricao       String?
  tipo            TipoProjeto
  tipoProjetoId   String?            @map("tipo_projeto_id")
  tipoProjeto     TipoProjetoConfig? @relation(fields: [tipoProjetoId], references: [id])
  modo            ModoProjeto   @default(COMPLETO)
  status          StatusProjeto @default(PLANEJAMENTO)
  nivel           Int           @default(1)
  dataInicio      DateTime?     @map("data_inicio")
  dataFimPrevista DateTime?     @map("data_fim_prevista")
  dataFimReal     DateTime?     @map("data_fim_real")
  custoPrevisto   Decimal?      @map("custo_previsto") @db.Decimal(12, 2)
  custoRealizado  Decimal?      @map("custo_realizado") @db.Decimal(12, 2)
  observacoes     String?
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  projetoPaiId String?  @map("projeto_pai_id")
  projetoPai   Projeto? @relation("ProjetoHierarquia", fields: [projetoPaiId], references: [id])
  subProjetos  Projeto[] @relation("ProjetoHierarquia")

  softwareId String?   @map("software_id")
  software   Software? @relation(fields: [softwareId], references: [id])

  contratoId String?   @map("contrato_id")
  contrato   Contrato? @relation(fields: [contratoId], references: [id])

  responsavelId String  @map("responsavel_id")
  responsavel   Usuario @relation("ProjetoResponsavel", fields: [responsavelId], references: [id])

  // Workspace Multi-Departamento (Onda 1 Sub-fase 1.1 — D31/D32)
  // Subprojetos herdam departamento do projeto-pai (D14, validado no service).
  departamentoId String       @map("departamento_id")
  departamento   Departamento @relation(fields: [departamentoId], references: [id])

  membros    MembroProjeto[]
  fases      FaseProjeto[]
  atividades AtividadeProjeto[]

  cotacoes            CotacaoProjeto[]
  custos              CustoProjeto[]
  riscos              RiscoProjeto[]
  anexos              AnexoProjeto[]
  apontamentos        ApontamentoHoras[]
  dependenciasOrigem  DependenciaProjeto[] @relation("DependenciaOrigem")
  dependenciasDestino DependenciaProjeto[] @relation("DependenciaDestino")
  chamados            Chamado[]
  usuariosChave       UsuarioChaveProjeto[]
  pendencias          PendenciaProjeto[]
  notaFiscalItens     NotaFiscalItem[]
  parcelaRateios      ParcelaRateioProjeto[]
  favoritos           ProjetoFavorito[]

  @@index([status])
  @@index([projetoPaiId])
  @@index([softwareId])
  @@index([departamentoId])
  @@map("projetos")
  @@schema("gestao_ti")
}

model ProjetoFavorito {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  projetoId String  @map("projeto_id")
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation("ProjetoFavoritoUsuario", fields: [usuarioId], references: [id])

  @@unique([usuarioId, projetoId])
  @@map("projetos_favorito")
  @@schema("gestao_ti")
}

model MembroProjeto {
  id          String    @id @default(uuid())
  papel       PapelRaci
  observacoes String?
  createdAt   DateTime  @default(now()) @map("created_at")

  projetoId String  @map("projeto_id")
  projeto   Projeto @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  @@unique([projetoId, usuarioId])
  @@map("membros_projeto")
