# =============================================
# Capul Platform — Variáveis de Ambiente (Template)
# =============================================

# Banco de Dados
DB_USER=capul_user
DB_PASSWORD=ALTERAR_SENHA_SEGURA
DB_NAME=capul_platform
DB_PORT=5432

# ---------------------------------------------------------------
# Base RFB (Receita Dados Abertos) — banco DEDICADO, separado do capul-db.
# Default (vars abaixo COMENTADAS) = container local `postgres-rfb`.
#
# Para apontar a RFB a uma máquina EXTERNA (ex.: máquina de DEV que já tem os
# 41 GB carregados, ou a máquina exclusiva da RFB), descomente e ajuste — o
# fiscal-backend monta RFB_DATABASE_URL a partir destas vars. Nesse caso NÃO
# suba o container local postgres-rfb.
# A máquina externa precisa expor a porta do Postgres e ser alcançável.
# (boot do Fiscal é resiliente: se a RFB estiver fora, só as consultas RFB
#  degradam — NF-e/CT-e/Protheus seguem.)
#
# CREDENCIAIS DEDICADAS (RFB_DB_USER/RFB_DB_PASSWORD): use uma role read-only
# própria da RFB, desacoplada do banco operacional — assim a senha do capul_user
# de HOM/PROD NÃO precisa ser igual à da máquina que hospeda a RFB. Crie a role
# uma vez no Postgres RFB (ver roteiro de deploy). Se deixar vazias, o backend
# cai para DB_USER/DB_PASSWORD (exige senha igual nos dois lados — não recomendado).
# RFB_DB_HOST=172.16.0.159     # IP da máquina externa (ex.: máquina de DEV)
# RFB_DB_PORT=5433             # porta exposta no host externo
# RFB_DB_NAME=capul_rfb
# RFB_DB_USER=rfb_reader       # role read-only dedicada na RFB
# RFB_DB_PASSWORD=ALTERAR_SENHA_RFB_READER

# JWT (COMPARTILHADO entre todos os backends)
JWT_SECRET=ALTERAR_CHAVE_SECRETA_MINIMO_64_CARACTERES
JWT_REFRESH_SECRET=ALTERAR_OUTRA_CHAVE_DIFERENTE_PARA_REFRESH
# Auditoria 10/05/2026 #B1 — secret separado p/ MFA token (gerar com openssl rand -hex 64)
JWT_MFA_SECRET=ALTERAR_CHAVE_SECRETA_TERCEIRA_DIFERENTE_PARA_MFA
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# App entregador (Logistica Fase 1b): access mobile curto + sessao deslizante.
# O app renova silenciosamente; entregador ativo so reloga apos 30d SEM uso.
JWT_MOBILE_EXPIRATION=15m
JWT_MOBILE_REFRESH_EXPIRATION=30d

# Sugestao de rota (Logistica Fase 1c parte 2) — distancia REAL de rua via OSRM.
# OPT-IN: sem OSRM_URL, a sugestao usa haversine (linha reta), comportamento
# padrao. Para ligar (serviço já no compose, profile osrm):
#   1) docker compose --profile osrm-prep run --rm osrm-prep   # baixa+processa (1x, ~min)
#   2) docker compose --profile osrm up -d osrm
#   3) descomente OSRM_URL abaixo e recrie o logistica-backend
# OSRM_URL=http://osrm:5000
# OSRM_TIMEOUT_MS=8000
# Região do extract OSM (Geofabrik). Default Minas Gerais.
# OSRM_REGION=minas-gerais
# OSRM_PBF_URL=https://download.geofabrik.de/south-america/brazil/minas-gerais-latest.osm.pbf

# CORS — lista de origens permitidas (separadas por vírgula). Auditoria #B3 (10/05/2026): obrigatório.
CORS_ORIGINS=https://platform.capul.com.br,https://localhost

# Redis
REDIS_URL=redis://redis:6379

# PgAdmin
PGADMIN_EMAIL=admin@capul.com
PGADMIN_PASSWORD=ALTERAR_SENHA
