model RfbCruzamentoResultado {
  id              Int      @id @default(autoincrement())
  cnpj            String
  origem          String // SA1010 | SA2010
  filial          String?
  codigo          String?
  loja            String?
  razaoProtheus   String?  @map("razao_protheus")
  // IE do Protheus (SA1/SA2) — dado bruto do ERP, NÃO validado contra
  // SEFAZ/CCC. A base RFB Dados Abertos não tem IE (registro estadual).
  inscricaoEstadual   String? @map("inscricao_estadual")
  inscricaoEstadualUf String? @map("inscricao_estadual_uf")
  bloqueado       Boolean  @default(false)
  achadoRfb       Boolean  @map("achado_rfb")
  situacaoRfb     String?  @map("situacao_rfb")
  razaoRfb        String?  @map("razao_rfb")
  ufRfb           String?  @map("uf_rfb")
  municipioRfb    String?  @map("municipio_rfb")
  dataSituacao    String?  @map("data_situacao")
  cnae            String?
  porte           String?
  optanteSimples  String?  @map("optante_simples")
  alerta          String // OK | ATENCAO | IRREGULAR | NAO_ENCONTRADO
  // F1.8 — divergência de razão social (dimensão independente do alerta).
  divergenciaRazao  Boolean @default(false) @map("divergencia_razao")
  similaridadeRazao Int?    @map("similaridade_razao")
  // Gap B — ação recomendada cruzando situação RFB × estado Protheus.
  acao            String  @default("NENHUMA") // BLOQUEAR | REVISAR | NENHUMA
  atualizadoEm    DateTime @default(now()) @map("atualizado_em")

  @@map("cruzamento_resultado")
  @@schema("rfb")
}

