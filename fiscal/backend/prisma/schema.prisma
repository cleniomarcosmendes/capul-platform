  porte            String?
  capitalSocial    Decimal? @map("capital_social") @db.Decimal(18, 2)
  // F1.9 Camada 2
  qualificacaoResponsavel String? @map("qualificacao_responsavel")
  enteFederativo          String? @map("ente_federativo")

  @@map("empresas")
  @@schema("rfb")
}

// F1.9 — domínios de descrição (mesmo padrão de RfbCnae).
model RfbMotivo {
