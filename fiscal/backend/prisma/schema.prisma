// ============================================================
// SCHEMA rfb — Base Pública CNPJ (Receita Federal · Dados Abertos)
// Importação mensal supervisionada. SEM certificado, SEM SEFAZ — zero
// risco de bloqueio. Plano: docs/PLANO_MODULO_CNPJ_RFB_v1.md (v1.1 c/
// addendum F0/PoC). Colunas em text (Postgres: text == varchar storage;
// footprint medido na PoC ~250 B/linha estab, ~170 B/linha empresa).
// Índices btree + GIN pg_trgm são criados na migration.sql (autoritativa).
// ============================================================

model RfbEstabelecimento {
  cnpjCompleto      String  @id @map("cnpj_completo")
  cnpjBasico        String  @map("cnpj_basico")
  cnpjOrdem         String? @map("cnpj_ordem")
  cnpjDv            String? @map("cnpj_dv")
  matrizFilial      String? @map("matriz_filial")
  nomeFantasia      String? @map("nome_fantasia")
  situacaoCadastral String? @map("situacao_cadastral")
  dataSituacao      String? @map("data_situacao")
  cnaePrincipal     String? @map("cnae_principal")
  logradouro        String?
  numero            String?
  bairro            String?
  cep               String?
  uf                String?
  municipio         String?
  ddd1              String?
  telefone1         String?
  correioEletronico String? @map("correio_eletronico")
  // F1.9 Camada 2 — campos analíticos extras (já vinham no ZIP).
  motivoSituacao       String? @map("motivo_situacao")
  dataInicioAtividade  String? @map("data_inicio_atividade")
  cnaeSecundaria       String? @map("cnae_secundaria")
  situacaoEspecial     String? @map("situacao_especial")
  dataSituacaoEspecial String? @map("data_situacao_especial")
