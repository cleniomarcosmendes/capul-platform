model RfbControleImportacao {
  id             Int       @id @default(autoincrement())
  versaoRfb      String    @unique @map("versao_rfb")
  status         String // DISPONIVEL | IMPORTANDO | CONCLUIDO | ERRO
  dataDeteccao   DateTime? @map("data_deteccao")
  dataInicio     DateTime? @map("data_inicio")
  dataFim        DateTime? @map("data_fim")
  totalRegistros BigInt?   @map("total_registros")
  disparadoPor   String?   @map("disparado_por")
