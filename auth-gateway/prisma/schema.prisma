generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["core"]
}

enum StatusGeral {
  ATIVO
  INATIVO

  @@schema("core")
}

enum TipoUsuario {
  INDIVIDUAL
  PADRAO

  @@schema("core")
}

model TipoDepartamento {
  id        String      @id @default(uuid())
  nome      String      @unique
  descricao String?
  ordem     Int         @default(0)
  status    StatusGeral @default(ATIVO)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  departamentos Departamento[]

  @@map("tipos_departamento")
  @@schema("core")
}

model Empresa {
  id           String   @id @default(uuid())
  razaoSocial  String   @map("razao_social")
  nomeFantasia String   @map("nome_fantasia")
  cnpjMatriz   String?  @unique @map("cnpj_matriz")
  endereco     String?
  cidade       String?
  estado       String?
  cep          String?
  telefone     String?
  email        String?
  logoUrl      String?  @map("logo_url")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  filiais Filial[]

  @@map("empresas")
  @@schema("core")
}

model Filial {
  id           String      @id @default(uuid())
  codigo       String      @unique
  razaoSocial  String?     @map("razao_social")
  nomeFantasia String      @map("nome_fantasia")
  cnpj         String?     @unique
  descricao    String?
  endereco     String?
  cidade       String?
  estado       String?
  cep          String?
  telefone     String?
  email        String?
  status       StatusGeral @default(ATIVO)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  departamentos  Departamento[]
  centrosCusto   CentroCusto[]
  usuarios       Usuario[]       @relation("FilialPrincipal")
  usuarioFiliais UsuarioFilial[]

  @@map("filiais")
  @@schema("core")
}

model Departamento {
  id        String      @id @default(uuid())
  codigo    String?
  nome      String
  descricao String?
  status    StatusGeral @default(ATIVO)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  filialId           String           @map("filial_id")
  filial             Filial           @relation(fields: [filialId], references: [id])
  tipoDepartamentoId String           @map("tipo_departamento_id")
  tipoDepartamento   TipoDepartamento @relation(fields: [tipoDepartamentoId], references: [id])

  usuarios Usuario[]

  // Workspace Multi-Departamento (Onda 1 Sub-fase 1.2 — D36)
  permissoesModulo PermissaoModulo[]

  // Workspace Multi-Departamento (Onda 1 Sub-fase 1.3 — D32)
  funcionalidades DepartamentoFuncionalidade[]

  @@unique([filialId, nome])
  @@map("departamentos")
  @@schema("core")
}

model CentroCusto {
  id        String      @id @default(uuid())
  codigo    String
  nome      String
  descricao String?
  status    StatusGeral @default(ATIVO)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  filialId String @map("filial_id")
  filial   Filial @relation(fields: [filialId], references: [id])

  @@unique([filialId, codigo])
  @@map("centros_custo")
  @@schema("core")
}

model Usuario {
  id             String      @id @default(uuid())
  username       String      @unique
  email          String?     @unique
  nome           String
  senha          String
  telefone       String?
  cargo          String?
  avatarUrl      String?     @map("avatar_url")
  status         StatusGeral  @default(ATIVO)
  tipo           TipoUsuario  @default(INDIVIDUAL) @map("tipo")
  primeiroAcesso Boolean      @default(true) @map("primeiro_acesso")
  mfaSecret      String?     @map("mfa_secret")
  mfaEnabled     Boolean     @default(false) @map("mfa_enabled")
  ultimoLogin    DateTime?   @map("ultimo_login")
  preferencias   Json        @default("{}") @map("preferencias")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  filialPrincipalId String?      @map("filial_principal_id")
  filialPrincipal   Filial?      @relation("FilialPrincipal", fields: [filialPrincipalId], references: [id])
  departamentoId    String       @map("departamento_id")
  departamento      Departamento @relation(fields: [departamentoId], references: [id])

  filiais       UsuarioFilial[]
  permissoes    PermissaoModulo[]
  refreshTokens RefreshToken[]
  capabilities  UsuarioCapability[]
  dispositivoSessoes DispositivoSessao[]

  @@map("usuarios")
  @@schema("core")
}

/// Capability explícita POR USUÁRIO p/ dado sensível (LGPD), desacoplada
/// do papel. v1: FISCAL_CONSULTA_SOCIOS (acesso a PII de sócios — Busca
/// por Sócio + QSA da Consulta Cadastral). Concedida só por ADMIN no
/// Configurador, com motivo. Linha preservada na revogação (auditoria
/// de concessão: concedido_por/em + revogado_por/em). Plano:
/// docs/PLANO_FISCAL_CONSULTA_SOCIOS_LGPD_v1.md
model UsuarioCapability {
  id           String    @id @default(uuid())
  usuarioId    String    @map("usuario_id")
  usuario      Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  capability   String
  ativo        Boolean   @default(true)
  motivo       String
  concedidoPor String    @map("concedido_por")
  concedidoEm  DateTime  @default(now()) @map("concedido_em")
  revogadoPor  String?   @map("revogado_por")
  revogadoEm   DateTime? @map("revogado_em")

  @@unique([usuarioId, capability])
  @@index([capability, ativo])
  @@map("usuario_capability")
  @@schema("core")
}

model UsuarioFilial {
  id        String    @id @default(uuid())
  isDefault Boolean   @default(false) @map("is_default")
  createdAt DateTime  @default(now()) @map("created_at")
  createdBy String?   @map("created_by")
  updatedAt DateTime? @updatedAt @map("updated_at")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  filialId  String  @map("filial_id")
  filial    Filial  @relation(fields: [filialId], references: [id])

  @@unique([usuarioId, filialId])
  @@map("usuario_filiais")
  @@schema("core")
}

model ModuloSistema {
  id          String      @id @default(uuid())
  codigo      String      @unique
  nome        String
  descricao   String?
  icone       String?
  cor         String?
  urlFrontend String?     @map("url_frontend")
  urlBackend  String?     @map("url_backend")
  ordem       Int         @default(0)
  status      StatusGeral @default(ATIVO)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  rolesDisponiveis RoleModulo[]
  permissoes       PermissaoModulo[]

  @@map("modulos_sistema")
  @@schema("core")
}

model RoleModulo {
  id        String  @id @default(uuid())
  codigo    String
  nome      String
  descricao String?

  moduloId String        @map("modulo_id")
  modulo   ModuloSistema @relation(fields: [moduloId], references: [id])

  permissoes PermissaoModulo[]

  @@unique([moduloId, codigo])
  @@map("roles_modulo")
  @@schema("core")
}

model PermissaoModulo {
  id        String      @id @default(uuid())
  status    StatusGeral @default(ATIVO)
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  usuarioId    String        @map("usuario_id")
  usuario      Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  moduloId     String        @map("modulo_id")
  modulo       ModuloSistema @relation(fields: [moduloId], references: [id])
  roleModuloId String        @map("role_modulo_id")
  roleModulo   RoleModulo    @relation(fields: [roleModuloId], references: [id])

  // Workspace Multi-Departamento (Onda 1 Sub-fase 1.2 — D36/P7)
  // departamentoId NOT NULL — toda permissão tem depto explícito.
  // Multi-perfil habilitado pela @@unique abaixo (mesmo usuário pode ter
  // role diferente em depto diferente do mesmo módulo).
  // NÃO criar coluna is_super_admin (D36/Q5): ADMIN é global via role,
  // guard backend detecta role==='ADMIN' e pula filtros departamentais.
  departamentoId String       @map("departamento_id")
  departamento   Departamento @relation(fields: [departamentoId], references: [id])

  @@unique([usuarioId, moduloId, departamentoId])
  @@index([departamentoId])
  @@index([usuarioId])
  @@map("permissoes_modulo")
  @@schema("core")
}

// ============================================================================
// Workspace Multi-Departamento (Onda 1 Sub-fase 1.3 — D32)
// ============================================================================
// Tabela de habilitação granular: depto × funcionalidade. Backend filtra
// menus/endpoints baseado em (deptos do user) × (funcionalidades ativas).
// Inicialmente T.I. tem todas as 12 ativas (status quo). Demais deptos
// recebem funcionalidades sob demanda via UI Configurador (Sub-fase 1.6).
// Ver doc-mestre v1.2 §4.2.12.
// ============================================================================

enum FuncionalidadeWorkspace {
  CHAMADO
  PROJETO
  OS
  EQUIPE
  CONTRATO
  NOTA_FISCAL
  SOFTWARE
  LICENCA
  ATIVO
  PARADA
  INDICADOR_OPERACIONAL
  INDICADOR_ESTRATEGICO
  PAINEL_GESTAO_CHAMADO
  PAINEL_GESTAO_PROJETO

  // S16.4 (27/05) — Cadastros operacionais como funcionalidades configuráveis.
  // Dados shared entre workspaces (taxonomias); só a visibilidade do menu
  // é per-depto. Backfill em T.I. (preserva status quo); demais deptos
  // ativam manualmente via Configurador.
  CADASTRO_DEPARTAMENTO
  CADASTRO_CENTRO_CUSTO
  CADASTRO_NATUREZA_FINANCEIRA
  CADASTRO_TIPO_CONTRATO
  CADASTRO_FORNECEDOR
  CADASTRO_PRODUTO
  CADASTRO_TIPO_PRODUTO
  CADASTRO_TIPO_PROJETO
  CADASTRO_CATEGORIA_LICENCA

  // S16.5 (27/05) — Sweep total: todos os itens do menu viram configuráveis.
  // CONHECIMENTO/CATALOGO_SERVICO antes compartilhavam CHAMADO.
  // CHAMADO_EXTERNO antes compartilhava INDICADOR_ESTRATEGICO.
  // DASHBOARD/MONITOR/ACOMPANHAMENTO/ACOMPANHAMENTO_ITEM/SLA/HORARIO_TRABALHO/
  // IMPORTAR_DADOS são novos. Backfill em T.I. (preserva status quo).
  CONHECIMENTO
  CATALOGO_SERVICO
  DASHBOARD
  MONITOR
  ACOMPANHAMENTO
  ACOMPANHAMENTO_ITEM
  SLA
  HORARIO_TRABALHO
  IMPORTAR_DADOS
  CHAMADO_EXTERNO

  @@schema("core")
}

model DepartamentoFuncionalidade {
  id              String                  @id @default(uuid())
  departamentoId  String                  @map("departamento_id")
  departamento    Departamento            @relation(fields: [departamentoId], references: [id], onDelete: Cascade)
  funcionalidade  FuncionalidadeWorkspace
  ativo           Boolean                 @default(true)
  ativadoEm       DateTime                @default(now()) @map("ativado_em")
  ativadoPor      String                  @map("ativado_por")
  desativadoEm    DateTime?               @map("desativado_em")
  desativadoPor   String?                 @map("desativado_por")

  @@unique([departamentoId, funcionalidade])
  @@index([departamentoId])
  @@map("departamento_funcionalidades")
  @@schema("core")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  // Sessão de dispositivo (login mobile). Web não usa → nullable.
  dispositivoSessaoId String?            @map("dispositivo_sessao_id")
  dispositivoSessao   DispositivoSessao? @relation(fields: [dispositivoSessaoId], references: [id], onDelete: Cascade)

  @@index([dispositivoSessaoId])
  @@map("refresh_tokens")
  @@schema("core")
}

/// Sessão de um dispositivo logado (app mobile). Estável entre rotações do
/// refresh token. Revogação em 3 níveis: sessão (esta), dispositivo (deviceId)
/// ou usuário (todas). O refresh valida que a sessão não está revogada/expirada
/// (Opção B — efeito em ≤ TTL do access mobile, 15m). Web não cria sessão.
model DispositivoSessao {
  id            String         @id @default(uuid())
  usuarioId     String         @map("usuario_id")
  usuario       Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  deviceId      String         @map("device_id") // id estável do aparelho (gerado no app)
  deviceInfo    String?        @map("device_info") // modelo/SO legível
  plataforma    String? // ANDROID | IOS
  criadoEm      DateTime       @default(now()) @map("criado_em")
  ultimoUso     DateTime       @default(now()) @map("ultimo_uso")
  expiraEm      DateTime       @map("expira_em")
  revogadoEm    DateTime?      @map("revogado_em")
  revogadoPorId String?        @map("revogado_por_id") // quem revogou (admin ou o próprio)
  refreshTokens RefreshToken[]

  @@index([usuarioId])
  @@index([deviceId])
  @@map("dispositivo_sessao")
  @@schema("core")
}

enum AmbienteIntegracao {
  PRODUCAO
  HOMOLOGACAO

  @@schema("core")
}

enum MetodoHttp {
  GET
  POST
  PUT
  PATCH
  DELETE

  @@schema("core")
}

enum TipoAuth {
  BASIC
  BEARER
  API_KEY
  NONE

  @@schema("core")
}

enum ModuloConsumidor {
  FISCAL
  GESTAO_TI
  INVENTARIO

  @@schema("core")
}

model IntegracaoApi {
  id          String              @id @default(uuid())
  codigo      String              @unique
  nome        String
  descricao   String?
  tipoAuth    TipoAuth            @default(BASIC) @map("tipo_auth")
  authConfig  String?             @map("auth_config")
  ativo       Boolean             @default(true)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  endpoints IntegracaoApiEndpoint[]

  @@map("integracoes_api")
  @@schema("core")
}

model IntegracaoApiEndpoint {
  id            String              @id @default(uuid())
  modulo        ModuloConsumidor
  ambiente      AmbienteIntegracao
  operacao      String
  descricao     String?
  url           String
  metodo        MetodoHttp          @default(GET)
  timeoutMs     Int                 @default(30000) @map("timeout_ms")
  headers       Json?
  ativo         Boolean             @default(true)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  integracaoId  String              @map("integracao_id")
  integracao    IntegracaoApi       @relation(fields: [integracaoId], references: [id], onDelete: Cascade)

  @@unique([integracaoId, modulo, ambiente, operacao])
  @@map("integracoes_api_endpoints")
  @@schema("core")
}

model SystemConfig {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String?
  descricao String?
  categoria String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_config")
  @@schema("core")
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String
  message   String
  module    String?
  action    String?
  usuarioId String?  @map("usuario_id")
  ipAddress String?  @map("ip_address")
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("system_logs")
  @@schema("core")
}

// =============================================================================
// Backup & DR — Auditoria 26/04/2026 Sprint 4
// =============================================================================
// Registra execucoes do scripts/backup.sh para visibilidade no Configurador.
// Script POSTa em /api/v1/internal/backup/execucao apos cada run (sucesso ou falha).
// =============================================================================
model BackupExecucao {
  id          String   @id @default(uuid())
  tipo        String   // full | app | db | uploads | certs | env | redis
  status      String   // SUCESSO | FALHA | EM_ANDAMENTO
  iniciadoEm  DateTime @default(now()) @map("iniciado_em")
  finalizadoEm DateTime? @map("finalizado_em")
  duracaoMs   Int?     @map("duracao_ms")
  tamanhoBytes BigInt? @map("tamanho_bytes")
  hostname    String?
  destino     String?  // local | s3 | etc — onde foi gravado
  cifrado     Boolean  @default(false)
  mensagem    String?  // erro ou resumo
  metadata    Json?    // dados extras (paths, contagens, etc.)

  @@index([iniciadoEm(sort: Desc)])
  @@index([status])
  @@map("backup_execucoes")
  @@schema("core")
}
