{
  "expo": {
    "name": "CAPUL Entregas",
    "slug": "capul-entregas",
    "owner": "capul",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "capulentregas",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "br.com.capul.entregas",
      "versionCode": 3,
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "0d458eb9-9907-43b7-92ca-ab1d431482b0"
      }
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "O CAPUL Entregas usa sua localização durante a viagem (inclusive em segundo plano) para o monitoramento da rota pela gestão."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "./plugins/withWindowsCmakeVersion.js",
      "./plugins/withEntregasFlavors.js"
    ],
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/0d458eb9-9907-43b7-92ca-ab1d431482b0"
    },
    "ios": {}
  }
}
