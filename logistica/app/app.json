{
  "expo": {
    "name": "CAPUL Entregas",
    "slug": "capul-entregas",
    "owner": "capul",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "capulentregas",
    "userInterfaceStyle": "light",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "br.com.capul.entregas",
      "versionCode": 2,
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA"
      ]
    },
    "extra": {
      "//": "API_URL — apontar pro nginx alcançável pelo celular. Em DEV use o IP da LAN da máquina (ex.: https://192.168.x.x). Sobrescreve via env EXPO_PUBLIC_API_URL.",
      "apiUrl": "https://platform.capul.com.br"
    },
    "plugins": [
      "expo-asset",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "O CAPUL Entregas usa sua localização durante a viagem (inclusive em segundo plano) para o monitoramento da rota pela gestão."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "./plugins/withWindowsCmakeVersion.js"
    ]
  }
}
