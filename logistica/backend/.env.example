# Logística Backend — variáveis de ambiente
# Banco (schema `logistica` no mesmo capul_platform; multi-schema isolado)
DATABASE_URL="postgresql://capul_user:SENHA@capul-db:5432/capul_platform?schema=logistica"

# JWT compartilhado com o Auth Gateway (mesmo segredo de toda a plataforma)
JWT_SECRET="<mesmo-do-auth-gateway>"

# CORS — OBRIGATÓRIO (lista separada por vírgula). Sem fallback permissivo.
CORS_ORIGINS="https://localhost"

PORT=3003
NODE_ENV=development
