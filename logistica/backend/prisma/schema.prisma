// ============================================================
// Módulo Logística (Entregas/Frota) — Plataforma Capul
// Prisma 6 multi-schema — schema próprio `logistica`.
// Referência: 004_Fase1a_Schema_PRs.md (v2.1).
//
// PR1 (scaffold): apenas o schema `logistica`. Referências a core
// (usuarios/filiais/departamentos) são gravadas como String (id), SEM
// relação Prisma — o mirror read-only de core entra na PR2 quando houver
// consulta/join real. Mantém a migration inicial 100% aditiva e isolada.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["logistica"]
}

// ---------- Enums ----------
enum TipoClienteEntrega {
  IDENTIFICADO
  RECORRENTE_LOCAL
  EVENTUAL
  @@schema("logistica")
}

// Como a venda foi feita — indicador de canal (balcão vs remoto).
// Nullable na Entrega: registros anteriores à feature ficam "desconhecido".
enum OrigemVenda {
  PRESENCIAL
  TELE_VENDA
  OUTRO
  @@schema("logistica")
}

enum StatusEntrega {
  PENDENTE
  EM_VIAGEM
  ENTREGUE
  NAO_ENTREGUE
  CANCELADA
  @@schema("logistica")
}

enum TipoViagem {
  ENTREGA
  FROTA
  SUPERVISOR
  @@schema("logistica")
}

enum StatusViagem {
  RASCUNHO
  EM_CURSO
  CONCLUIDA
  CANCELADA
  @@schema("logistica")
}

// Ciclo do PLANEJAMENTO do supervisor (redesenho 6b): o supervisor planeja e
// envia; o coordenador aprova/ajusta/rejeita; depois executa e conclui.
enum StatusPlanejamento {
  RASCUNHO
  ENVIADO
  APROVADO
  AJUSTADO
  REJEITADO
  EM_EXECUCAO
  CONCLUIDO
  // Força maior depois do aval (Jul/2026): a viagem não vai acontecer (representante
  // afastado, veículo quebrado, região remanejada). Antes só existia Ajustar/Rejeitar,
  // que valem apenas no ENVIADO — depois de APROVADO o planejamento ficava pendurado
  // para sempre, e "cancelar" na prática virava esvaziar as visitas e concluir (RDV
  // concluído e vazio, sujando histórico e fechamento). CANCELADO não entra na
  // prestação de contas; reabrir (Supervisor de Departamento) desfaz.
  CANCELADO
  @@schema("logistica")
}

enum SituacaoVeiculo {
  DISPONIVEL
  EM_USO
  EM_MANUTENCAO
  BAIXADO
  @@schema("logistica")
}

enum TipoVeiculo {
  CARRO
  UTILITARIO
  CAMINHAO
  OUTRO
  @@schema("logistica")
}

// Propriedade do veículo: da frota própria da CAPUL ou alugado.
enum PropriedadeVeiculo {
  PROPRIO
  ALUGADO
  @@schema("logistica")
}

// Porte do veículo (eixo de classificação, independente da finalidade).
enum PorteVeiculo {
  PESADO
  LEVE
  @@schema("logistica")
}

// Finalidade de uso (eixo de classificação). Leves se dividem em entrega do
// supermercado × passeio; SERVICO cobre apoio/manutenção. Cruzado com porte na
// Análise da Frota (ex.: custo dos leves de entrega × dos de passeio).
enum FinalidadeVeiculo {
  ENTREGA
  PASSEIO
  SERVICO
  @@schema("logistica")
}

// Governança de despesas (Fase 2): motorista lança PENDENTE → supervisor/gestor
// aprova (entra nos indicadores) ou contesta. Lançamento direto por
// supervisor/gestor já nasce APROVADA.
enum StatusDespesa {
  PENDENTE
  APROVADA
  CONTESTADA
  @@schema("logistica")
}

// Categoria da despesa (Fase 2 — módulo Supervisores/RDV): despesa do VEÍCULO
// (combustível, manutenção…) ou do INDIVÍDUO (alimentação, hospedagem — sem
// veículo). INDIVÍDUO não entra nos relatórios por veículo; a RDV soma as duas.
enum CategoriaDespesa {
  VEICULO
  INDIVIDUO
  @@schema("logistica")
}

// Status de uma parada de frota. Ad-hoc/legado nasce REALIZADA (default);
// parada planejada nasce PLANEJADA e vira REALIZADA no check-in (ou PULADA).
enum StatusParada {
  PLANEJADA
  REALIZADA
  PULADA
  @@schema("logistica")
}

// Situação do adiantamento do RDV (aprovação pelo coordenador). O adiantamento
// lançado pelo PRÓPRIO supervisor de área (auto-serviço) nasce PENDENTE e o
// coordenador APROVA/REJEITA; o lançado pelo coordenador/departamento já nasce
// APROVADO. Só APROVADO entra no saldo da RDV.
enum SituacaoAdiantamento {
  PENDENTE
  APROVADO
  REJEITADO
  @@schema("logistica")
}

// Tipo do local geolocalizado de um cliente (SA1). Um cliente pode ter VÁRIOS locais
// (a fazenda ≠ o endereço de entrega urbano) — por isso a chave é cliente+tipo+nome.
enum TipoLocalCliente {
  PROPRIEDADE
  ENTREGA
  OUTRO
  @@schema("logistica")
}

// Confiança da localização CONSOLIDADA do local (aprendida das marcações de campo).
// SEM_DADO = ainda sem marcação boa; PROVISORIA = 1-2 marcações / disperso; CONFIRMADA
// = várias marcações concordando dentro do raio.
enum ConfiancaLocal {
  SEM_DADO
  PROVISORIA
  CONFIRMADA
  @@schema("logistica")
}

// Local geolocalizado de um cliente (SA1) — a "verdade de campo" que o Protheus NÃO
// tem. Um cliente tem N locais (fazendas, endereço de entrega…). A coordenada é
// CONSOLIDADA a partir das marcações (paradas) de qualquer origem: visita de supervisor
// OU parada de saída de veículo. `nome` estrutura o que antes era texto livre
// (`parada.propriedade`), dando chave estável ao agrupamento.
model LocalCliente {
  id               String           @id @default(uuid())
  filialId         String?          @map("filial_id")
  clienteMatricula String           @map("cliente_matricula")
  clienteNome      String?          @map("cliente_nome")
  tipo             TipoLocalCliente @default(PROPRIEDADE)
  nome             String
  municipio        String?
  // Geolocalização CONSOLIDADA (medóide do cluster mais denso das marcações).
  latConsolidada   Decimal?         @map("lat_consolidada") @db.Decimal(10, 7)
  longConsolidada  Decimal?         @map("long_consolidada") @db.Decimal(10, 7)
  confianca        ConfiancaLocal   @default(SEM_DADO)
  nMarcacoes       Int              @default(0) @map("n_marcacoes")
  raioDispersaoM   Int?             @map("raio_dispersao_m")
  consolidadoEm    DateTime?        @map("consolidado_em")
  // Export ao Protheus (Fase C, quando houver endpoint de escrita) — auditoria.
  enviadoProtheusEm DateTime?       @map("enviado_protheus_em")
  ativo            Boolean          @default(true)
  criadoEm         DateTime         @default(now()) @map("criado_em")
  paradas          Parada[]

  @@unique([clienteMatricula, tipo, nome])
  @@index([clienteMatricula])
  @@index([filialId])
  @@map("local_cliente")
  @@schema("logistica")
}

// ---------- Cliente / Endereço (GLOBAIS, cross-filial) ----------
model ClienteLocal {
  id         String            @id @default(uuid())
  filialId   String?           @map("filial_id") // filial dona (escopo por cidade)
  nome       String
  telefone   String?
  observacao String?
  ativo      Boolean           @default(true)
  criadoEm   DateTime          @default(now()) @map("criado_em")
  enderecos  EnderecoEntrega[]
  entregas   Entrega[]

  @@index([telefone])
  @@index([nome])
  @@index([filialId])
  @@map("cliente_local")
  @@schema("logistica")
}

model EnderecoEntrega {
  id              String        @id @default(uuid())
  filialId        String?       @map("filial_id") // filial dona (escopo por cidade)
  matricula       String?
  clienteLocalId  String?       @map("cliente_local_id")
  clienteLocal    ClienteLocal? @relation(fields: [clienteLocalId], references: [id])
  apelido         String?
  // Telefone DESTE endereço — é o contato que o entregador liga ao chegar no
  // local (cada endereço pode ter o seu, ex.: casa de parente). Vai junto no
  // snapshot da entrega (entrega.telefone) e reaparece ao reusar o endereço.
  telefone        String?
  logradouro      String
  numero          String?
  complemento     String?
  bairro          String?
  cidade          String?
  uf              String?
  cep             String?
  pontoReferencia String?       @map("ponto_referencia")
  latitude        Decimal?      @db.Decimal(10, 7)
  longitude       Decimal?      @db.Decimal(10, 7)
  ativo           Boolean       @default(true)
  criadoEm        DateTime      @default(now()) @map("criado_em")
  entregas        Entrega[]

  @@index([matricula])
  @@index([clienteLocalId])
  @@index([filialId])
  @@map("endereco_entrega")
  @@schema("logistica")
}

// ---------- Frota (cadastro central compartilhado Fase 1 + Fase 2) ----------
model Veiculo {
  id                    String          @id @default(uuid())
  filialId              String          @map("filial_id")
  placa                 String
  renavam               String?
  chassi                String?
  modelo                String?
  marca                 String?
  ano                   Int?
  cor                   String?
  tipo                  TipoVeiculo     @default(CARRO)
  propriedade           PropriedadeVeiculo @default(PROPRIO)
  // Classificação (2 eixos, opcionais — gestor classifica o cadastro existente).
  porte                 PorteVeiculo?
  finalidade            FinalidadeVeiculo?
  kmAtual               Int             @default(0) @map("km_atual")
  capacidadeCarga       String?         @map("capacidade_carga")
  situacao              SituacaoVeiculo @default(DISPONIVEL)
  // Manutenção preventiva por KM (Fase 2). intervalo = a cada quantos km revisa;
  // kmProximaManutencao = odômetro-alvo da próxima (kmUltima + intervalo). O
  // Monitor da Frota alerta quando kmAtual se aproxima/passa da próxima.
  intervaloManutencaoKm Int?            @map("intervalo_manutencao_km")
  kmUltimaManutencao    Int?            @map("km_ultima_manutencao")
  kmProximaManutencao   Int?            @map("km_proxima_manutencao")
  departamentoLotacaoId String          @map("departamento_lotacao_id")
  supervisorId          String          @map("supervisor_id")
  // Supervisor de ÁREA (atendente técnico da Indústria/Filial 18) que fica com o
  // veículo p/ as visitas — funcionário Protheus (por MATRÍCULA). DISTINTO do
  // supervisorId (encarregado que GERENCIA o veículo). Ver PLANO_LOGISTICA_REPRESENTANTES_v1.
  supervisorAreaMatricula String?       @map("supervisor_area_matricula")
  supervisorAreaNome      String?       @map("supervisor_area_nome")
  ativo                 Boolean         @default(true)
  criadoEm              DateTime        @default(now()) @map("criado_em")
  viagens               Viagem[]
  historicoSupervisor   VeiculoSupervisorHistorico[]
  historicoSupervisorArea VeiculoSupervisorAreaHistorico[]
  despesas              DespesaVeiculo[]
  manutencoes           ManutencaoVeiculo[]

  @@unique([filialId, placa])
  @@index([filialId, situacao])
  @@index([supervisorId])
  @@index([supervisorAreaMatricula])
  @@index([departamentoLotacaoId])
  @@map("veiculo")
  @@schema("logistica")
}

// Manutenção do veículo (Fase — manutenção): PREVENTIVA (do ciclo por KM) ou
// CORRETIVA/excepcional (fora do ciclo — quebra, acidente, conserto pontual).
enum TipoManutencao {
  PREVENTIVA
  CORRETIVA
  @@schema("logistica")
}

// Histórico de manutenções do veículo. Cada registro pode (ou não) REINICIAR o
// ciclo preventivo — quando reinicia, grava a próxima revisão (km + intervalo).
model ManutencaoVeiculo {
  id              String         @id @default(uuid())
  veiculoId       String         @map("veiculo_id")
  veiculo         Veiculo        @relation(fields: [veiculoId], references: [id])
  tipo            TipoManutencao @default(PREVENTIVA)
  km              Int
  dataManutencao  DateTime       @map("data_manutencao")
  motivo          String?
  custo           Decimal?       @db.Decimal(12, 2)
  reiniciouCiclo  Boolean        @default(false) @map("reiniciou_ciclo")
  kmProximaGerada Int?           @map("km_proxima_gerada")
  registradoPorId String         @map("registrado_por_id")
  criadoEm        DateTime       @default(now()) @map("criado_em")
  // Despesa gerada pelo `custo` desta manutenção. O custo NAO e somado a partir
  // daqui: quem responde por dinheiro na Analise/indicadores e a despesa_veiculo,
  // e so ela. Este vinculo existe pra (a) rastrear a origem e (b) garantir 1 custo
  // = 1 despesa (nao ha contagem dupla nem custo invisivel). SetNull: apagar a
  // despesa nao apaga a manutencao — o historico de KM/ciclo sobrevive.
  despesaId       String?         @unique @map("despesa_id")
  despesa         DespesaVeiculo? @relation(fields: [despesaId], references: [id], onDelete: SetNull)

  @@index([veiculoId, dataManutencao])
  @@map("manutencao_veiculo")
  @@schema("logistica")
}

model VeiculoSupervisorHistorico {
  id                   String   @id @default(uuid())
  veiculoId            String   @map("veiculo_id")
  veiculo              Veiculo  @relation(fields: [veiculoId], references: [id])
  supervisorAnteriorId String?  @map("supervisor_anterior_id")
  supervisorNovoId     String   @map("supervisor_novo_id")
  alteradoEm           DateTime @default(now()) @map("alterado_em")
  alteradoPorId        String   @map("alterado_por_id")

  @@index([veiculoId])
  @@map("veiculo_supervisor_historico")
  @@schema("logistica")
}

// Histórico de troca do Supervisor de ÁREA do veículo (por matrícula Protheus).
model VeiculoSupervisorAreaHistorico {
  id                  String   @id @default(uuid())
  veiculoId           String   @map("veiculo_id")
  veiculo             Veiculo  @relation(fields: [veiculoId], references: [id])
  matriculaAnterior   String?  @map("matricula_anterior")
  matriculaNova       String   @map("matricula_nova")
  nomeNovo            String?  @map("nome_novo")
  alteradoEm          DateTime @default(now()) @map("alterado_em")
  alteradoPorId       String   @map("alterado_por_id")

  @@index([veiculoId])
  @@map("veiculo_supervisor_area_historico")
  @@schema("logistica")
}

// ---------- Despesas da frota (Fase 2) ----------
// Cadastro auxiliar de tipos (combustível, oficina, pneu, pedágio, multa, IPVA,
// seguro…). Gerenciado pelo gestor de frota; cada tipo vira dimensão de
// indicadores. GLOBAL (sem filial) — é uma classificação da empresa.
model TipoDespesa {
  id        String           @id @default(uuid())
  nome      String           @unique
  descricao String?
  // Fase 2: VEÍCULO (default — combustível, manutenção…) ou INDIVÍDUO (alimentação,
  // hospedagem — despesa da pessoa, sem veículo, entra só na RDV).
  categoria CategoriaDespesa @default(VEICULO)
  ativo     Boolean          @default(true)
  // Se true, a despesa lançada pelo motorista na viagem nasce PENDENTE e exige
  // validação do supervisor/gestor. Se false (ex.: Abastecimento), entra direto
  // APROVADA. Lançamento direto por supervisor/gestor já é APROVADA de qualquer forma.
  requerAprovacao Boolean    @default(true) @map("requer_aprovacao")
  criadoEm  DateTime         @default(now()) @map("criado_em")
  despesas  DespesaVeiculo[]

  @@map("tipo_despesa")
  @@schema("logistica")
}

// Fornecedor da despesa de frota — cadastro PRÓPRIO da logística (postos,
// borracharias, lava-jatos...), separado do FornecedorConfig de TI (gestao_ti),
// que é de TI/telecom. Gerenciado pelo gestor de frota, igual aos tipos de
// despesa. Seed inclui "NÃO DEFINIDO" (default quando não informado).
model FornecedorDespesa {
  id        String           @id @default(uuid())
  nome      String           @unique
  ativo     Boolean          @default(true)
  criadoEm  DateTime         @default(now()) @map("criado_em")
  despesas  DespesaVeiculo[]

  @@map("fornecedor_despesa")
  @@schema("logistica")
}

// Despesa vincula SEMPRE a Veiculo (chave principal de análise) e OPCIONALMENTE
// a Viagem (quando contextualizada). Fora do escopo: rateio por departamento e
// integração financeira com Protheus (gestão própria do módulo). filialId é
// denormalizado do veículo p/ escopo/índices.
model DespesaVeiculo {
  id            String        @id @default(uuid())
  filialId      String        @map("filial_id")
  // OPCIONAL a partir da Fase 2: despesa de INDIVÍDUO (alimentação/hospedagem do
  // supervisor) não tem veículo. Despesa de VEÍCULO continua exigindo (no service).
  // onDelete EXPLÍCITO (Restrict, igual ao banco): SetNull — o default do Prisma p/
  // relação opcional — deixaria a despesa órfã e o custo sumiria da análise por
  // veículo sem erro nenhum. Melhor barrar o delete (que ninguém faz: veículo é baixado).
  veiculoId     String?       @map("veiculo_id")
  veiculo       Veiculo?      @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  viagemId      String?       @map("viagem_id")
  viagem        Viagem?       @relation(fields: [viagemId], references: [id])
  tipoDespesaId String        @map("tipo_despesa_id")
  tipoDespesa   TipoDespesa   @relation(fields: [tipoDespesaId], references: [id])
  valor         Decimal       @db.Decimal(12, 2)
  dataDespesa   DateTime      @map("data_despesa")
  // Fornecedor: ref ao cadastro próprio (preferido) + texto livre (retrocompat /
  // posto não cadastrado). Indicadores agrupam por fornecedorRef.nome › fornecedor › "NÃO DEFINIDO".
  fornecedorId  String?            @map("fornecedor_id")
  fornecedorRef FornecedorDespesa? @relation(fields: [fornecedorId], references: [id])
  fornecedor    String?
  observacao    String?
  // Nota fiscal / documento. Pode não existir (semNota=true → ex.: nota de débito
  // da borracharia em viagem). Chave de duplicidade é (veiculo, documento, tipo):
  // a MESMA nota pode gerar vários lançamentos no veículo se forem TIPOS distintos
  // (rateio); repetir veículo+documento+tipo é bloqueado (índice parcial único na
  // migration). semNota não entra na checagem (documento nulo repete por natureza).
  numeroDocumento String? @map("numero_documento")
  semNota         Boolean @default(false) @map("sem_nota")
  situacao      StatusDespesa @default(PENDENTE)
  // Anormalidade (mau uso): o GESTOR da frota sinaliza quando a despesa decorre
  // de uso indevido do veículo. Destaca/segrega esse custo na Análise para não
  // distorcer a leitura de um veículo que "estourou" por um evento atípico.
  anormalidade       Boolean @default(false)
  motivoAnormalidade String? @map("motivo_anormalidade")
  // Foto do recibo/cupom (lastro da aprovação). O binário vive no object store
  // (MinIO, reusa o CofreStorageService); aqui ficam só a chave + hash + mime.
  comprovanteObjectKey String? @map("comprovante_object_key")
  comprovanteHash      String? @map("comprovante_hash")
  comprovanteMime      String? @map("comprovante_mime")
  // Autor: quando o motorista lança na viagem (matrícula+senha Protheus).
  autorMatricula String?      @map("autor_matricula")
  autorNome      String?      @map("autor_nome")
  // Usuário do sistema que registrou (operador do terminal / supervisor / gestor).
  criadoPorId   String        @map("criado_por_id")
  criadoEm      DateTime      @default(now()) @map("criado_em")
  // Validação (governança).
  aprovadoPorId      String?   @map("aprovado_por_id")
  aprovadoEm         DateTime? @map("aprovado_em")
  motivoContestacao  String?   @map("motivo_contestacao")
  // Chave de idempotência (Fase 2d offline): reenvio da fila não duplica a despesa.
  idempotencyKey String? @unique @map("idempotency_key")
  // Volta do vínculo com a manutenção que gerou esta despesa (quando veio de lá).
  manutencao     ManutencaoVeiculo?
  // Vários comprovantes (Jul/2026): a despesa pode ter até N anexos (fotos/PDF). Os
  // campos comprovante* acima são o LEGADO (1 anexo) — convivem; leitura junta os dois.
  anexos         AnexoDespesa[]

  @@index([filialId, situacao])
  @@index([veiculoId])
  @@index([viagemId])
  @@index([tipoDespesaId])
  // Criado pela migration 20260616140000_fornecedor_despesa (escrita à mão) e nunca
  // declarado aqui — o schema ficou devendo o índice que o banco já tem.
  @@index([fornecedorId])
  @@map("despesa_veiculo")
  @@schema("logistica")
}

// Anexo (comprovante) da despesa — vários por despesa (foto/PDF). O binário vive no
// object store (MinIO, CofreStorageService); aqui ficam a chave + hash + mime + ordem.
model AnexoDespesa {
  id        String         @id @default(uuid())
  despesaId String         @map("despesa_id")
  despesa   DespesaVeiculo @relation(fields: [despesaId], references: [id], onDelete: Cascade)
  objectKey String         @map("object_key")
  hash      String?
  mime      String?
  tamanho   Int?
  ordem     Int            @default(0)
  criadoEm  DateTime       @default(now()) @map("criado_em")

  @@index([despesaId])
  @@map("anexo_despesa")
  @@schema("logistica")
}

// ---------- Contador sequencial por filial (nº de entrega e de viagem) ----------
model ContadorSequencial {
  filialId     String @map("filial_id")
  escopo       String
  ultimoNumero Int    @default(0) @map("ultimo_numero")

  @@id([filialId, escopo])
  @@map("contador_sequencial")
  @@schema("logistica")
}

// ---------- Entrega (pedido de entrega — por filial) ----------
model Entrega {
  id                String             @id @default(uuid())
  numero            Int
  filialId          String             @map("filial_id")
  tipoCliente       TipoClienteEntrega @map("tipo_cliente")
  matricula         String?
  clienteLocalId    String?            @map("cliente_local_id")
  clienteLocal      ClienteLocal?      @relation(fields: [clienteLocalId], references: [id])
  destinatarioNome  String             @map("destinatario_nome")
  telefone          String?
  enderecoEntregaId String?            @map("endereco_entrega_id")
  enderecoEntrega   EnderecoEntrega?   @relation(fields: [enderecoEntregaId], references: [id])
  endLogradouro     String             @map("end_logradouro")
  endNumero         String?            @map("end_numero")
  endComplemento    String?            @map("end_complemento")
  endBairro         String?            @map("end_bairro")
  endCidade         String?            @map("end_cidade")
  endUf             String?            @map("end_uf") @db.VarChar(2)
  endCep            String?            @map("end_cep")
  endReferencia     String?            @map("end_referencia")
  horario           String?
  observacoes       String?
  quantidadeVolumes Int                @default(1) @map("quantidade_volumes")
  origemVenda       OrigemVenda?       @map("origem_venda")
  // Re-entrega (cliente ausente etc.): nº da tentativa atual + trilha das
  // tentativas anteriores (motivo/quando/quem) preservada ao voltar pra fila.
  tentativas        Int                @default(1)
  historicoTentativas Json?            @map("historico_tentativas")
  status            StatusEntrega      @default(PENDENTE)
  criadoEm          DateTime           @default(now()) @map("criado_em")
  criadoPorId       String             @map("criado_por_id")
  // Quem REGISTROU de fato (accountability): em login PADRAO (caixa) é o
  // colaborador identificado por matrícula+senha; em login INDIVIDUAL é o
  // próprio usuário (resolvido do core). criadoPorId continua sendo o login.
  registradoPorMatricula String?       @map("registrado_por_matricula")
  registradoPorNome      String?       @map("registrado_por_nome")
  canceladaEm       DateTime?          @map("cancelada_em")
  canceladaPorId    String?            @map("cancelada_por_id")
  motivoCancelamento String?           @map("motivo_cancelamento")
  // Referência ao COFRE de comprovante (banco isolado — Fase 1b). A evidência
  // (baixa/foto/assinatura/hash/gps) NÃO mora aqui; mora no cofre. Cross-DB, sem FK.
  temComprovante    Boolean            @default(false) @map("tem_comprovante")
  comprovanteId     String?            @map("comprovante_id")
  // Baixa de entrega (Fase 1b). ENTREGUE/NAO_ENTREGUE são estados terminais.
  dataHoraEntrega   DateTime?          @map("data_hora_entrega")
  motivoNaoEntrega  String?            @map("motivo_nao_entrega")
  baixadoPorId      String?            @map("baixado_por_id")
  // Quem recebeu a mercadoria (informado na baixa) — resposta rápida ao
  // cliente sem precisar abrir a trilha do cofre.
  recebedorNome     String?            @map("recebedor_nome")
  // GPS POR EVENTO capturado na baixa (pontual — LGPD; não é rastreio contínuo).
  geoLat            Decimal?           @map("geo_lat") @db.Decimal(10, 7)
  geoLng            Decimal?           @map("geo_lng") @db.Decimal(10, 7)
  cupons            EntregaCupom[]
  parada            Parada?

  @@unique([filialId, numero])
  @@index([filialId, status])
  @@index([matricula])
  @@index([criadoEm])
  @@map("entrega")
  @@schema("logistica")
}

model EntregaCupom {
  id          String   @id @default(uuid())
  entregaId   String   @map("entrega_id")
  entrega     Entrega  @relation(fields: [entregaId], references: [id], onDelete: Cascade)
  numeroCupom String?  @map("numero_cupom")
  valor       Decimal? @db.Decimal(12, 2)

  @@index([entregaId])
  @@map("entrega_cupom")
  @@schema("logistica")
}

// ---------- Viagem GENERALIZADA (entrega na Fase 1, frota na Fase 2) ----------
model Viagem {
  id                        String       @id @default(uuid())
  numero                    Int
  filialId                  String       @map("filial_id")
  tipo                      TipoViagem   @default(ENTREGA)
  // Nullable (12/06): o RASCUNHO pode nascer só com a carga — veículo e
  // motorista são definidos depois; o DESPACHO é que exige os dois.
  // onDelete EXPLÍCITO: quando o campo virou opcional, o default do Prisma passou
  // de Restrict p/ SetNull, mas a FK no banco continuou Restrict — e Restrict é o
  // certo: apagar um veículo não pode esvaziar silenciosamente a viagem que ele
  // rodou. Veículo sai de operação por BAIXA (status), nunca por DELETE.
  veiculoId                 String?      @map("veiculo_id")
  veiculo                   Veiculo?     @relation(fields: [veiculoId], references: [id], onDelete: Restrict)
  motoristaId               String?      @map("motorista_id")
  departamentoSolicitanteId String?      @map("departamento_solicitante_id")
  kmInicial                 Int?         @map("km_inicial")
  kmFinal                   Int?         @map("km_final")
  localSaida                String?      @map("local_saida")
  dataHoraSaida             DateTime?    @map("data_hora_saida")
  observacoesSaida          String?      @map("observacoes_saida")
  dataHoraChegada           DateTime?    @map("data_hora_chegada")
  observacoesChegada        String?      @map("observacoes_chegada")
  // Condutor da viagem de FROTA (funcionário validado no Protheus por matrícula+
  // senha — NÃO é usuário do sistema). Em ENTREGA o condutor é o motoristaId.
  condutorMatricula         String?      @map("condutor_matricula")
  condutorNome              String?      @map("condutor_nome")
  // Saída registrada pela PORTARIA (exceção): o usuário autorizado apontou a
  // viagem ao condutor por NOME, SEM a senha dele — accountability é do
  // criadoPorId. false = condutor se auto-autenticou (matrícula+senha).
  registradaPortaria        Boolean      @default(false) @map("registrada_portaria")
  // Fluxo PORTARIA: qual PORTEIRO (funcionário, matrícula+senha do Protheus) operou
  // a saída e o retorno — accountability distinta do motorista (condutorMatricula).
  porteiroSaidaMatricula    String?      @map("porteiro_saida_matricula")
  porteiroSaidaNome         String?      @map("porteiro_saida_nome")
  porteiroRetornoMatricula  String?      @map("porteiro_retorno_matricula")
  porteiroRetornoNome       String?      @map("porteiro_retorno_nome")
  situacao                  StatusViagem @default(RASCUNHO)
  // Viagem do SUPERVISOR (Fase 3b): container MENSAL da prestação de contas (RDV).
  // mesReferencia = AAAAMM (ex.: 202605); adiantamento = valor liberado; região do
  // supervisor. Reusa condutorMatricula/Nome p/ identificar o supervisor de área.
  mesReferencia             Int?         @map("mes_referencia")
  // OBSOLETO (redesenho 6b): adiantamento vira a tabela Adiantamento (mensal, N).
  adiantamento              Decimal?     @db.Decimal(12, 2)
  // Planejamento do supervisor: ciclo de aprovação próprio + vínculo ao Supervisor
  // cadastrado (que leva ao coordenador que aprova).
  statusPlanejamento        StatusPlanejamento? @map("status_planejamento")
  supervisorRegistroId      String?      @map("supervisor_registro_id")
  supervisorRegistro        Supervisor?  @relation(fields: [supervisorRegistroId], references: [id])
  aprovadoPorId             String?      @map("aprovado_por_id")
  aprovadoEm                DateTime?    @map("aprovado_em")
  comentarioCoordenador     String?      @map("comentario_coordenador")
  // Cancelamento do planejamento (força maior). Motivo é OBRIGATÓRIO na regra de
  // negócio — a coluna é nullable só porque as linhas antigas não têm.
  canceladoPorId            String?      @map("cancelado_por_id")
  canceladoEm               DateTime?    @map("cancelado_em")
  motivoCancelamento        String?      @map("motivo_cancelamento")
  criadoEm                  DateTime     @default(now()) @map("criado_em")
  criadoPorId               String       @map("criado_por_id")
  // Encerramento do ACERTO (independente da conclusão da viagem): presença =
  // acerto TRAVADO (sem novas despesas/adiantamento); reabrir volta a NULL.
  acertoEncerradoEm         DateTime?    @map("acerto_encerrado_em")
  acertoEncerradoPorId      String?      @map("acerto_encerrado_por_id")
  // Quem FECHOU a viagem (retorno) e quando. Antes ninguém sabia — havia
  // `criadoPorId` (quem abriu) e `acertoEncerradoPorId` (quem encerrou o
  // acerto), mas nada para o retorno. Vale para TODOS os fluxos (individual,
  // PADRÃO e portaria) e é o que substitui, com rastro de verdade, a exigência
  // de redigitar a matrícula do condutor quando ela não podia ser conferida.
  fechadoPorId              String?      @map("fechado_por_id")
  fechadoEm                 DateTime?    @map("fechado_em")
  // Encerramento FORÇADO pelo gestor de entrega: a rota ficou pendurada EM_CURSO
  // (ex.: o entregador esqueceu o retorno). Neste caminho o KM final é OBRIGATÓRIO
  // (mantém o odômetro íntegro); guarda quem forçou e quando — accountability
  // distinta da conclusão feita pelo próprio entregador no app.
  fechadoForcadoPorId       String?      @map("fechado_forcado_por_id")
  fechadoForcadoEm          DateTime?    @map("fechado_forcado_em")
  // Vínculo Saída de frota → planejamento RDV (viagem SUPERVISOR): várias saídas
  // apontam p/ 1 RDV; o RDV soma o KM das saídas. Auto-relação na própria tabela.
  rdvViagemId               String?      @map("rdv_viagem_id")
  rdvViagem                 Viagem?      @relation("SaidaRdv", fields: [rdvViagemId], references: [id], onDelete: SetNull)
  saidasVinculadas          Viagem[]     @relation("SaidaRdv")
  paradas                   Parada[]
  despesas                  DespesaVeiculo[]
  posicoes                  PosicaoVeiculo[]

  @@unique([filialId, numero])
  @@index([filialId, situacao])
  @@index([veiculoId])
  @@index([motoristaId])
  @@index([tipo])
  @@index([supervisorRegistroId])
  // Criado pela migration 20260708140000_viagem_rdv_link (escrita à mão) e nunca
  // declarado aqui — o schema ficou devendo o índice que o banco já tem.
  @@index([rdvViagemId])
  @@map("viagem")
  @@schema("logistica")
}

// ---------- Parada — generaliza "entrega na viagem" e "parada livre" ----------
model Parada {
  id           String    @id @default(uuid())
  viagemId     String    @map("viagem_id")
  viagem       Viagem    @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  sequencia    Int
  entregaId    String?   @unique @map("entrega_id")
  entrega      Entrega?  @relation(fields: [entregaId], references: [id])
  local        String?
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  km           Int?
  dataHora     DateTime? @map("data_hora")
  observacao   String?
  // Planejamento (Fase 2b): parada PLANEJADA → REALIZADA (check-in) / PULADA.
  // `planejadoLocal` guarda o que foi planejado (separado do `local` realizado);
  // `realizadaEm` é o carimbo do check-in (≠ registradoEm = quando a linha nasceu).
  status         StatusParada @default(REALIZADA)
  planejadoLocal String?      @map("planejado_local")
  realizadaEm    DateTime?    @map("realizada_em")
  // Justificativa quando a visita é PULADA (obrigatória no app ao pular) — aparece no
  // relatório de visitas. Só faz sentido com status PULADA; zerada ao virar REALIZADA.
  motivoPulada   String?      @map("motivo_pulada")
  // Visita do supervisor (Fase 3c): atividade + região + propriedade/fazenda +
  // cliente (matrícula/sócio Protheus estruturado) + município. `observacao` = obs.
  atividadeId      String?          @map("atividade_id")
  atividade        AtividadeVisita? @relation(fields: [atividadeId], references: [id])
  clienteMatricula String?          @map("cliente_matricula")
  clienteNome      String?          @map("cliente_nome")
  municipio        String?
  propriedade      String?
  // Local geolocalizado (Fase A geo): liga a marcação (esta parada) ao local do cliente
  // que ela ajuda a consolidar. Nullable: parada avulsa/prospect sem local escolhido.
  localClienteId   String?          @map("local_cliente_id")
  localCliente     LocalCliente?    @relation(fields: [localClienteId], references: [id])
  // Qualidade da marcação: precisão do GPS (m) e confirmação do usuário de que está NO
  // local (≠ marcou da estrada/cidade). Só marcações `noLocal=true` e precisas
  // alimentam a consolidação. Nullable = legado/desconhecido.
  precisaoM        Int?             @map("precisao_m")
  noLocal          Boolean?         @map("no_local")
  // Chave de idempotência (Fase 2d offline): reenvio da fila não duplica a parada.
  idempotencyKey String?   @unique @map("idempotency_key")
  registradoEm DateTime  @default(now()) @map("registrado_em")

  @@index([viagemId, sequencia])
  @@index([atividadeId])
  @@index([localClienteId])
  @@map("parada")
  @@schema("logistica")
}

// Rastreamento em tempo real (Fase A, 19/06/2026) — pings de GPS enviados pelo
// app DURANTE a viagem em curso (foreground). Cada linha é um ponto do trajeto
// (trail); o Monitor da Frota mostra a ÚLTIMA posição por viagem ativa.
// LGPD: só grava com viagem EM_CURSO (liga na saída, para no retorno); rastro
// bruto tem retenção curta (o GPS da baixa/entrega é lastro separado). Acesso
// de leitura restrito a gestores.
model PosicaoVeiculo {
  id          String   @id @default(uuid())
  viagemId    String   @map("viagem_id")
  viagem      Viagem   @relation(fields: [viagemId], references: [id], onDelete: Cascade)
  latitude    Decimal  @db.Decimal(10, 7)
  longitude   Decimal  @db.Decimal(10, 7)
  precisao    Decimal? @db.Decimal(7, 2) // metros (accuracy do GPS)
  velocidade  Decimal? @db.Decimal(7, 2) // m/s, quando disponível
  bateria     Int? // % do aparelho (0-100), quando disponível
  capturadoEm DateTime @map("capturado_em") // hora no device
  recebidoEm  DateTime @default(now()) @map("recebido_em")

  @@index([viagemId, capturadoEm])
  @@map("posicao_veiculo")
  @@schema("logistica")
}

// Cadastro de locais/pontos de parada frequentes (Fase 2d) — pick-list pro
// planejamento da rota (o condutor seleciona em vez de redigitar). Não é FK da
// parada: a parada guarda o texto (planejadoLocal); este cadastro é conveniência.
model LocalParada {
  id       String   @id @default(uuid())
  nome     String
  ativo    Boolean  @default(true)
  // Escopo (Fase 18/06): null em todos = global. filialId null = todas as
  // filiais. veiculoId set => local do veículo (rota do carro individual);
  // departamentoId set => local do depto. UI permite só UM dos dois (ou nenhum).
  filialId       String? @map("filial_id")
  departamentoId String? @map("departamento_id")
  veiculoId      String? @map("veiculo_id")
  criadoEm DateTime @default(now()) @map("criado_em")

  @@index([filialId])
  @@index([veiculoId])
  @@map("local_parada")
  @@schema("logistica")
}

// Cache de geocodificação (Fase 1c): endereço normalizado → lat/lng.
// MISS também é gravado (lat/lng null) pra não martelar os provedores com
// endereço que não resolve; limpar a linha força re-tentativa.
model GeocodeCache {
  id       String   @id @default(uuid())
  chave    String   @unique // hash do endereço normalizado
  endereco String // texto enviado ao provedor (debug/auditoria)
  lat      Decimal? @db.Decimal(10, 7)
  lng      Decimal? @db.Decimal(10, 7)
  fonte    String? // BRASILAPI_CEP | NOMINATIM | MANUAL
  precisao String? // CEP | LOGRADOURO | BAIRRO | CIDADE | MANUAL
  criadoEm DateTime @default(now()) @map("criado_em")
  // Correção manual (operador arrastou o pin no mapa da montagem de rota).
  // fonte=MANUAL nunca é sobrescrita pelo provedor — vale para TODA entrega
  // futura naquele endereço, então precisa de dono e data.
  corrigidoPorId String?   @map("corrigido_por_id")
  corrigidoEm    DateTime? @map("corrigido_em")

  @@map("geocode_cache")
  @@schema("logistica")
}

// ---- Catálogos do módulo Supervisores / RDV (Fase 3) ----

// Supervisor de Área (atendente técnico da Indústria) — cadastro que segura o
// VÍNCULO com o Coordenador. `matricula` = funcionário Protheus; `coordenadorId`
// = usuário do sistema (core.usuarios, sem FK cross-schema) que aprova os seus
// planejamentos/despesas. Cadastrado pelo "supervisor de departamento" (RBAC).
model Supervisor {
  id            String   @id @default(uuid())
  matricula     String
  nome          String
  filialId      String   @map("filial_id")
  // Departamento (core.departamento.id, gravado como String sem FK — convenção do
  // schema). Escopo do Supervisor de Departamento (SUPERVISOR_FROTA) no RDV: ele
  // gere só os representantes dos seus departamentos. Nullable: "montar o time"
  // define; registros antigos ficam sem depto até serem editados.
  departamentoId String? @map("departamento_id")
  coordenadorId String?  @map("coordenador_id")
  ativo         Boolean  @default(true)
  criadoEm      DateTime @default(now()) @map("criado_em")
  planejamentos Viagem[]
  adiantamentos Adiantamento[]
  fechamentos   FechamentoRdv[]

  @@unique([filialId, matricula])
  @@index([coordenadorId])
  @@index([departamentoId])
  @@map("supervisor")
  @@schema("logistica")
}

/// Quem é o SUPERVISOR DE DEPARTAMENTO (role SUPERVISOR_FROTA) de cada departamento,
/// para efeito do RDV. Antes isso era DERIVADO dos veículos que a pessoa supervisiona
/// (`veiculo.supervisorId` + `departamentoLotacaoId`) — um acoplamento acidental: aquele
/// campo existe para dizer quem responde pelo VEÍCULO (controle de frota), não para
/// definir autoridade sobre prestação de contas. O efeito colateral era silencioso: o
/// supervisor ficava sem veículo vinculado e perdia o RDV do departamento sem aviso.
/// A frota continua usando `veiculo.supervisorId` (lá o significado é o correto).
/// Um responsável por departamento/filial (@@unique) — trocar a pessoa é 1 linha.
model SupervisorDepartamento {
  id             String   @id @default(uuid())
  filialId       String   @map("filial_id")
  // core.departamentos.id e core.usuarios.id — String sem FK (convenção do schema:
  // core é read-only para a logística).
  departamentoId String   @map("departamento_id")
  usuarioId      String   @map("usuario_id")
  criadoEm       DateTime @default(now()) @map("criado_em")
  criadoPorId    String   @map("criado_por_id")

  @@unique([filialId, departamentoId])
  @@index([usuarioId])
  @@map("supervisor_departamento")
  @@schema("logistica")
}

/// Encerramento mensal do RDV (TEMA 2): presença = mês ENCERRADO (trava despesas e
/// adiantamentos do supervisor no mês); reabrir remove a linha.
model FechamentoRdv {
  id            String     @id @default(uuid())
  supervisorId  String     @map("supervisor_id")
  supervisor    Supervisor @relation(fields: [supervisorId], references: [id])
  mesReferencia Int        @map("mes_referencia")
  fechadoEm     DateTime   @default(now()) @map("fechado_em")
  fechadoPorId  String     @map("fechado_por_id")

  @@unique([supervisorId, mesReferencia])
  @@map("fechamento_rdv")
  @@schema("logistica")
}

// Adiantamento do supervisor (redesenho 6b): MENSAL, pode haver VÁRIOS. O saldo
// da RDV = Σ adiantamentos − Σ despesas aprovadas do mês/supervisor.
model Adiantamento {
  id              String     @id @default(uuid())
  supervisorId    String     @map("supervisor_id")
  supervisor      Supervisor @relation(fields: [supervisorId], references: [id])
  mesReferencia   Int        @map("mes_referencia")
  valor           Decimal    @db.Decimal(12, 2)
  dataAdiantamento DateTime  @map("data_adiantamento")
  observacao      String?
  lancadoPorId    String     @map("lancado_por_id")
  criadoEm        DateTime   @default(now()) @map("criado_em")
  // Aprovação (coordenador). Default APROVADO cobre linhas legadas e o lançamento
  // do coordenador/departamento; o auto-serviço do supervisor grava PENDENTE.
  situacao        SituacaoAdiantamento @default(APROVADO)
  decididoPorId   String?    @map("decidido_por_id")
  decididoEm      DateTime?  @map("decidido_em")
  motivoRejeicao  String?    @map("motivo_rejeicao")

  @@index([supervisorId, mesReferencia])
  @@map("adiantamento")
  @@schema("logistica")
}

// Atividade da visita (catálogo — a "lista fixa de tipos" da planilha Visitas).
// filialId null = global; senão escopo da filial.
model AtividadeVisita {
  id       String   @id @default(uuid())
  nome     String
  filialId String?  @map("filial_id")
  ativo    Boolean  @default(true)
  criadoEm DateTime @default(now()) @map("criado_em")
  visitas  Parada[]

  @@unique([filialId, nome])
  @@map("atividade_visita")
  @@schema("logistica")
}

